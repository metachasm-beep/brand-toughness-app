s.STDOUT, preexec_fn=os.setsid)\n","time.sleep(3)\n","\n","def read_tunnels():\n","    for port in (4040,4041,4042):\n","        try:\n","            return requests.get(f\"http://127.0.0.1:{port}/api/tunnels\", timeout=3).json()\n","        except Exception:\n","            pass\n","    return None\n","\n","data = read_tunnels()\n","if not data:\n","    print(\"❌ Could not read ngrok tunnels. Tail log:\")\n","    print(open(NGLOG).read()[-2000:])\n","    raise SystemExit(1)\n","\n","api_url = None\n","front_url = None\n","print(\"✅ ngrok tunnels:\")\n","for t in data.get(\"tunnels\", []):\n","    name=t.get(\"name\")\n","    pub=t.get(\"public_url\")\n","    addr=(t.get(\"config\", {}) or {}).get(\"addr\")\n","    print(\"-\", name, pub, \"->\", addr)\n","    if pub and pub.startswith(\"http://\"):\n","        pub=pub.replace(\"http://\",\"https://\")\n","    if name==\"api\": api_url = pub\n","    if name==\"front\": front_url = pub\n","\n","if not api_url or not front_url:\n","    print(\"❌ Missing api/front tunnel.\")\n","    print(open(NGLOG).read()[-2000:])\n","    raise SystemExit(1)\n","\n","# Inject ngrok API URL into Next.js and restart next\n","FRONT=\"/content/brandos_colab/front\"\n","subprocess.call(\"pkill -f 'next dev' || true\", shell=True)\n","time.sleep(1)\n","open(f\"{FRONT}/.env.local\",\"w\").write(f\"NEXT_PUBLIC_API_BASE={api_url}\\n\")\n","subprocess.Popen(f\"bash -lc 'cd {FRONT} && nohup npm run dev > {LOGS}/next.log 2>&1 &'\", shell=True)\n","time.sleep(3)\n","\n","# Final prints\n","print(\"\\n====================\")\n","print(\"✅ API BASE:\", api_url)\n","print(\"   /docs  :\", api_url + \"/docs\")\n","print(\"   /health:\", api_url + \"/health\")\n","print(\"\\n✅ FRONTEND:\", front_url)\n","print(\"   /login :\", front_url + \"/login\")\n","print(\"   /dash  :\", front_url + \"/dashboard\")\n","print(\"====================\\n\")\n","\n","# Quick remote sanity check\n","print(\"Remote health:\", requests.get(api_url + \"/health\", timeout=10).status_code)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PfTs0pIadP0V","executionInfo":{"status":"ok","timestamp":1772369571130,"user_tz":-330,"elapsed":8256,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"6b3d514e-01ff-4e5e-f9ea-fa41bb80557e"},"execution_count":265,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ ngrok tunnels:\n","- front https://kattie-tawie-rachal.ngrok-free.dev -> http://localhost:3000\n","- api https://kattie-tawie-rachal.ngrok-free.dev -> http://localhost:8000\n","\n","====================\n","✅ API BASE: https://kattie-tawie-rachal.ngrok-free.dev\n","   /docs  : https://kattie-tawie-rachal.ngrok-free.dev/docs\n","   /health: https://kattie-tawie-rachal.ngrok-free.dev/health\n","\n","✅ FRONTEND: https://kattie-tawie-rachal.ngrok-free.dev\n","   /login : https://kattie-tawie-rachal.ngrok-free.dev/login\n","   /dash  : https://kattie-tawie-rachal.ngrok-free.dev/dashboard\n","====================\n","\n","Remote health: 200\n"]}]},{"cell_type":"code","source":["import os, time, subprocess, requests, pathlib, re\n","\n","LOGS=\"/content/brandos_logs\"\n","pathlib.Path(LOGS).mkdir(parents=True, exist_ok=True)\n","NGROK=\"/content/bin/ngrok\"\n","CFG=\"/content/ngrok.yml\"\n","NGLOG=f\"{LOGS}/ngrok.log\"\n","\n","def ngrok_api():\n","    for port in (4040,4041,4042):\n","        try:\n","            return requests.get(f\"http://127.0.0.1:{port}/api/tunnels\", timeout=3).json()\n","        except Exception:\n","            pass\n","    return None\n","\n","def probe(url, path):\n","    try:\n","        r = requests.get(url+path, timeout=10, allow_redirects=True)\n","        ct = (r.headers.get(\"content-type\",\"\") or \"\").lower()\n","        return r.status_code, ct, r.text[:120]\n","    except Exception as e:\n","        return None, \"\", str(e)[:120]\n","\n","def show_and_probe(data):\n","    print(\"✅ ngrok tunnels found:\")\n","    tmap=[]\n","    for t in data.get(\"tunnels\", []):\n","        name=t.get(\"name\")\n","        pub=t.get(\"public_url\",\"\")\n","        addr=(t.get(\"config\", {}) or {}).get(\"addr\",\"\")\n","        if pub.startswith(\"http://\"):\n","            pub=pub.replace(\"http://\",\"https://\")\n","        print(f\"- {name:6} {pub} -> {addr}\")\n","        tmap.append((name,pub,addr))\n","\n","    print(\"\\n🔎 Probing public URLs:\")\n","    for name,pub,addr in tmap:\n","        s,ct,snip = probe(pub, \"/login\")\n","        print(f\"{name:6} /login -> {s} | {ct} | {snip.replace(chr(10),' ')}\")\n","        s2,ct2,snip2 = probe(pub, \"/health\")\n","        print(f\"{name:6} /health -> {s2} | {ct2} | {snip2.replace(chr(10),' ')}\")\n","        print(\"\")\n","\n","    # Heuristic: Next.js pages usually return text/html and contain \"<!DOCTYPE html\"\n","    front_candidates=[]\n","    for name,pub,addr in tmap:\n","        s,ct,snip = probe(pub, \"/login\")\n","        if (ct.startswith(\"text/html\") or \"<!DOCTYPE html\" in snip) and s in (200,307,308,404):\n","            front_candidates.append(pub)\n","\n","    return front_candidates, tmap\n","\n","data = ngrok_api()\n","if not data:\n","    print(\"❌ Can't read ngrok tunnels API. Restarting ngrok cleanly...\")\n","\n","# Always ensure config is correct, then restart ngrok if needed\n","def restart_ngrok():\n","    subprocess.call(\"pkill -f ngrok || true\", shell=True)\n","    time.sleep(1)\n","    open(CFG,\"w\").write(\"\"\"\\\n","version: \"2\"\n","tunnels:\n","  api:\n","    proto: http\n","    addr: 8000\n","  front:\n","    proto: http\n","    addr: 3000\n","\"\"\")\n","    f=open(NGLOG,\"w\")\n","    subprocess.Popen(f\"{NGROK} start --all --config {CFG} --log=stdout\",\n","                     shell=True, stdout=f, stderr=subprocess.STDOUT, preexec_fn=os.setsid)\n","    time.sleep(3)\n","    d = ngrok_api()\n","    if not d:\n","        print(\"❌ Still cannot read tunnels. ngrok log tail:\")\n","        print(open(NGLOG).read()[-2000:])\n","        raise SystemExit(1)\n","    return d\n","\n","# If tunnels missing or wrong, restart ngrok\n","if not data or not data.get(\"tunnels\"):\n","    data = restart_ngrok()\n","\n","front_candidates, tmap = show_and_probe(data)\n","\n","# If no front candidates, likely front tunnel is pointing to 8000 → restart ngrok and try again\n","if not front_candidates:\n","    print(\"⚠️ No HTML frontend detected. Restarting ngrok with correct tunnel mapping...\")\n","    data = restart_ngrok()\n","    front_candidates, tmap = show_and_probe(data)\n","\n","# Final recommendation\n","print(\"✅ RESULT:\")\n","api_pub = next((pub for name,pub,addr in tmap if name==\"api\"), None)\n","front_pub = next((pub for name,pub,addr in tmap if name==\"front\"), None)\n","\n","print(\"API URL    :\", api_pub)\n","print(\"FRONT URL  :\", front_pub)\n","\n","print(\"\\n➡️ OPEN THIS (frontend):\", (front_pub or \"<missing>\") + \"/login\")\n","print(\"➡️ API docs :\", (api_pub or \"<missing>\") + \"/docs\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vEZb02ckdrGy","executionInfo":{"status":"ok","timestamp":1772369669874,"user_tz":-330,"elapsed":10874,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"663ac844-5d5b-446b-d8df-9e35ea17f1bd"},"execution_count":266,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ ngrok tunnels found:\n","- api    https://kattie-tawie-rachal.ngrok-free.dev -> http://localhost:8000\n","- front  https://kattie-tawie-rachal.ngrok-free.dev -> http://localhost:3000\n","\n","🔎 Probing public URLs:\n","api    /login -> 404 | application/json | {\"detail\":\"Not Found\"}\n","api    /health -> 404 | text/html; charset=utf-8 | <!DOCTYPE html><html><head><style data-next-hide-fouc=\"true\">body{display:none}</style><noscript data-next-hide-fouc=\"tr\n","\n","front  /login -> 404 | application/json | {\"detail\":\"Not Found\"}\n","front  /health -> 404 | text/html; charset=utf-8 | <!DOCTYPE html><html><head><style 