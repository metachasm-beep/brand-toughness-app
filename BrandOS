 r = await apiFetch(\"/admin/login\", { method:\"POST\", body:{email,password}, auth:false });\n","    if(!r.ok){ setMsg(\"❌ \" + (r.json?.detail || r.text)); return; }\n","    setToken(r.json.access_token);\n","    setMsg(\"✅ Logged in. Redirecting…\");\n","    window.location.href=\"/dashboard\";\n","  }\n","\n","  return (\n","    <div className=\"container\">\n","      <h2 style={{margin:\"0 0 6px\"}}>BrandOS Audit — Next.js Frontend</h2>\n","      <div className=\"muted\">API: {API_BASE}</div>\n","\n","      <div className=\"card\">\n","        <h3 style={{margin:\"0 0 8px\"}}>Admin Login</h3>\n","        <label>Username</label>\n","        <input value={email} onChange={e=>setEmail(e.target.value)} />\n","        <label>Password</label>\n","        <input type=\"password\" value={password} onChange={e=>setPassword(e.target.value)} />\n","        <div className=\"row\" style={{marginTop:12}}>\n","          <button onClick={login}>Login</button>\n","          <span className=\"muted\">{msg}</span>\n","        </div>\n","      </div>\n","    </div>\n","  );\n","}\n","JS\n","\n","cat > \"$FRONT/pages/dashboard.js\" <<'JS'\n","import { useEffect, useState } from \"react\";\n","import { apiFetch, getToken, clearToken, API_BASE } from \"../lib/api\";\n","\n","export default function Dashboard(){\n","  const [url,setUrl]=useState(\"https://example.com\");\n","  const [mode,setMode]=useState(\"crawl\");\n","  const [auditId,setAuditId]=useState(\"\");\n","  const [status,setStatus]=useState(\"\");\n","  const [result,setResult]=useState(null);\n","  const [msg,setMsg]=useState(\"\");\n","\n","  useEffect(()=>{\n","    if(!getToken()) window.location.href=\"/login\";\n","  },[]);\n","\n","  async function startAudit(){\n","    setMsg(\"Starting…\");\n","    setResult(null);\n","    const r = await apiFetch(\"/audits/start\", { method:\"POST\", body:{url,mode}, auth:true });\n","    if(!r.ok){ setMsg(\"❌ \" + (r.json?.detail || r.text)); return; }\n","    setAuditId(r.json.audit_id);\n","    setStatus(\"QUEUED\");\n","    setMsg(\"✅ Started. Polling…\");\n","    poll(r.json.audit_id);\n","  }\n","\n","  async function poll(id){\n","    for(let i=0;i<220;i++){\n","      const r = await apiFetch(`/audits/${id}`, { auth:true });\n","      if(!r.ok){ setMsg(\"❌ \" + (r.json?.detail || r.text)); return; }\n","      setStatus(r.json.status);\n","      if(r.json.status === \"DONE\"){\n","        setResult(r.json.result);\n","        setMsg(\"✅ Done\");\n","        return;\n","      }\n","      await new Promise(res=>setTimeout(res, 1000));\n","    }\n","    setMsg(\"⚠️ Timed out\");\n","  }\n","\n","  async function openSharePdf(){\n","    if(!auditId) return;\n","    const r = await apiFetch(`/reports/${auditId}/share`, { method:\"POST\", auth:true });\n","    if(!r.ok){ setMsg(\"❌ \" + (r.json?.detail || r.text)); return; }\n","    window.open(`${API_BASE}/reports/shared/${r.json.token}.pdf`, \"_blank\");\n","  }\n","\n","  function logout(){ clearToken(); window.location.href=\"/login\"; }\n","\n","  return (\n","    <div className=\"container\">\n","      <div className=\"row\" style={{justifyContent:\"space-between\"}}>\n","        <div>\n","          <h2 style={{margin:\"0 0 6px\"}}>Dashboard</h2>\n","          <div className=\"muted\">API: {API_BASE}</div>\n","        </div>\n","        <button onClick={logout}>Logout</button>\n","      </div>\n","\n","      <div className=\"card\">\n","        <h3 style={{margin:\"0 0 8px\"}}>Start Audit</h3>\n","        <label>URL</label>\n","        <input value={url} onChange={e=>setUrl(e.target.value)} />\n","        <label>Mode</label>\n","        <select value={mode} onChange={e=>setMode(e.target.value)}>\n","          <option value=\"single\">single</option>\n","          <option value=\"crawl\">crawl</option>\n","        </select>\n","        <div className=\"row\" style={{marginTop:12}}>\n","          <button onClick={startAudit}>Start</button>\n","          <span className=\"muted\">{msg}</span>\n","        </div>\n","        <div className=\"muted\" style={{marginTop:10}}>\n","          Audit ID: <b>{auditId || \"—\"}</b> • Status: <b>{status || \"—\"}</b>\n","        </div>\n","        <div className=\"row\" style={{marginTop:10}}>\n","          <button onClick={openSharePdf}>Open Share PDF</button>\n","          <a href={`${API_BASE}/docs`} target=\"_blank\" rel=\"noreferrer\">API Docs</a>\n","        </div>\n","      </div>\n","\n","      <div className=\"card\">\n","        <h3 style={{margin:\"0 0 8px\"}}>Result</h3>\n","        <pre>{result ? JSON.stringify(result, null, 2) : \"Run an audit…\"}</pre>\n","      </div>\n","    </div>\n","  );\n","}\n","JS\n","\n","echo \"✅ Wrote full app to $ROOT\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9tiibjLBdEMc","executionInfo":{"status":"ok","timestamp":1772369505273,"user_tz":-330,"elapsed":604,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"d90909be-6ab8-47bb-ef8f-63bf4d5ab916"},"execution_count":263,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Wrote full app to /content/brandos_colab\n"]}]},{"cell_type":"code","source":["%%bash\n","set -e\n","\n","ROOT=\"/content/brandos_colab\"\n","API=\"$ROOT/api\"\n","FRONT=\"$ROOT/front\"\n","LOGS=\"/content/brandos_logs\"\n","mkdir -p \"$LOGS\"\n","\n","# Start Redis\n","redis-server --daemonize yes\n","sleep 1\n","redis-cli ping\n","\n","# Kill old servers if any\n","pkill -f \"uvicorn\" >/dev/null 2>&1 || true\n","pkill -f \"rq worker\" >/dev/null 2>&1 || true\n","pkill -f \"next dev\" >/dev/null 2>&1 || true\n","sleep 1\n","\n","# Start API\n","cd \"$API\"\n","nohup python run_api.py > \"$LOGS/api.log\" 2>&1 &\n","\n","# Start Worker\n","nohup python run_worker.py > \"$LOGS/worker.log\" 2>&1 &\n","\n","# Start Frontend\n","cd \"$FRONT\"\n","npm install >/dev/null\n","# set placeholder; we will overwrite with ngrok API URL in cell 5\n","echo \"NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000\" > 