L = os.getenv(\"DATABASE_URL\", \"sqlite:////content/brandos_colab/dev.db\")\n","REDIS_URL = os.getenv(\"REDIS_URL\", \"redis://127.0.0.1:6379/0\")\n","\n","JWT_SECRET = os.getenv(\"BRANDOS_JWT_SECRET\", os.getenv(\"JWT_SECRET\", \"dev-secret-change-me\"))\n","JWT_ALG = \"HS256\"\n","\n","ADMIN_EMAIL = os.getenv(\"ADMIN_EMAIL\", \"admin@example.com\").strip().lower()\n","ADMIN_PASSWORD = os.getenv(\"ADMIN_PASSWORD\", \"Admin#12345\")\n","\n","PAGESPEED_API_KEY = os.getenv(\"PAGESPEED_API_KEY\", \"\").strip()\n","PY\n","\n","cat > \"$API/app/db.py\" <<'PY'\n","from sqlalchemy import create_engine\n","from sqlalchemy.orm import sessionmaker, DeclarativeBase\n","from .config import DATABASE_URL\n","\n","engine = create_engine(DATABASE_URL, pool_pre_ping=True)\n","SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)\n","\n","class Base(DeclarativeBase):\n","    pass\n","\n","def get_db():\n","    db = SessionLocal()\n","    try:\n","        yield db\n","    finally:\n","        db.close()\n","PY\n","\n","cat > \"$API/app/models.py\" <<'PY'\n","import uuid\n","from sqlalchemy import String, Text, DateTime, Integer, Boolean, ForeignKey\n","from sqlalchemy.orm import Mapped, mapped_column\n","from datetime import datetime, timezone\n","from .db import Base\n","\n","def now():\n","    return datetime.now(timezone.utc)\n","\n","class Audit(Base):\n","    __tablename__ = \"audits\"\n","    id: Mapped[str] = mapped_column(String, primary_key=True, default=lambda: str(uuid.uuid4()))\n","    url: Mapped[str] = mapped_column(Text, nullable=False)\n","    mode: Mapped[str] = mapped_column(String(16), nullable=False, default=\"single\")  # single|crawl\n","    status: Mapped[str] = mapped_column(String(16), nullable=False, default=\"QUEUED\")  # QUEUED|RUNNING|DONE|FAILED\n","    job_id: Mapped[str | None] = mapped_column(String, nullable=True)\n","    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=now)\n","    finished_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)\n","    result_json: Mapped[str | None] = mapped_column(Text, nullable=True)\n","\n","class AuditPage(Base):\n","    __tablename__ = \"audit_pages\"\n","    id: Mapped[str] = mapped_column(String, primary_key=True, default=lambda: str(uuid.uuid4()))\n","    audit_id: Mapped[str] = mapped_column(String, ForeignKey(\"audits.id\"), nullable=False)\n","    url: Mapped[str] = mapped_column(Text, nullable=False)\n","    depth: Mapped[int] = mapped_column(Integer, default=0)\n","    status_code: Mapped[int | None] = mapped_column(Integer, nullable=True)\n","    title: Mapped[str | None] = mapped_column(Text, nullable=True)\n","    html_size: Mapped[int] = mapped_column(Integer, default=0)\n","    blocked_by_robots: Mapped[bool] = mapped_column(Boolean, default=False)\n","    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=now)\n","\n","class SharedReport(Base):\n","    __tablename__ = \"shared_reports\"\n","    id: Mapped[str] = mapped_column(String, primary_key=True, default=lambda: str(uuid.uuid4()))\n","    audit_id: Mapped[str] = mapped_column(String, ForeignKey(\"audits.id\"), nullable=False)\n","    token: Mapped[str] = mapped_column(String, unique=True, nullable=False)\n","    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=now)\n","    expires_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)\n","    revoked_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)\n","PY\n","\n","cat > \"$API/app/schemas.py\" <<'PY'\n","from pydantic import BaseModel, EmailStr, HttpUrl\n","\n","class AdminLogin(BaseModel):\n","    email: EmailStr\n","    password: str\n","\n","class StartAuditPayload(BaseModel):\n","    url: HttpUrl\n","    mode: str = \"single\"  # single|crawl\n","\n","class TokenOut(BaseModel):\n","    access_token: str\n","PY\n","\n","cat > \"$API/app/auth.py\" <<'PY'\n","import hashlib, hmac\n","from datetime import datetime, timedelta, timezone\n","from jose import jwt\n","from fastapi import HTTPException\n","from .config import ADMIN_EMAIL, ADMIN_PASSWORD, JWT_SECRET, JWT_ALG\n","\n","def _pbkdf2_hash(pw: str, salt: str) -> str:\n","    dk = hashlib.pbkdf2_hmac(\"sha256\", pw.encode(\"utf-8\"), salt.encode(\"utf-8\"), 120_000)\n","    return dk.hex()\n","\n","_SALT = \"admin:\" + ADMIN_EMAIL\n","\n","def verify_admin(email: str, password: str) -> bool:\n","    if (email or \"\").strip().lower() != ADMIN_EMAIL:\n","        return False\n","    # PBKDF2 has no 72-byte bcrypt limit; avoids your prior error entirely.\n","    a = _pbkdf2_hash(password or \"\", _SALT)\n","    b = _pbkdf2_hash(ADMIN_PASSWORD, _SALT)\n","    return hmac.compare_digest(a, b)\n","\n","def create_admin_token() -> str:\n","    now = datetime.now(timezone.utc)\n","    payload = {\n","        \"sub\": \"admin\",\n","        \"role\": \"admin\",\n","        \"iat\": int(now.timestamp()),\n","        \"exp\": int((now + timedelta(hours=6)).timestamp()),\n","    }\n","    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)\n","\n","def require_admin(token: str):\n","    try:\n","        p = jwt.decode(token, JWT_SECRET, algorithms=[JWT_ALG])\n","        if p.get(\"role\") != \"admin\":\n","            raise HTTPException(401, \"Not authorized\")\n","        return p\n","    except Exception:\n","        raise HTTPException(401, \"Invalid or expired token\")\n","PY\n","\n","cat > \"$API/app/rate_limit.py\" <<'PY'\n","from redis import Redis\n","from .config import REDIS_URL\n","\n","r = Redis.from_url(REDIS_URL, decode_responses=True)\n","\n","# Safe Lua-based rate limiter (no EXPIRE NX arg errors)\n","_LUA = \"\"\"\n","local v = redis.call('INCR', KEYS[1])\n","if tonumber(v) == 1 then\n","  redis.call('EXPIRE', KEYS[1], ARGV[1])\n","end\n","return v\n","\"\"\"\n","\n","def rate_limit(ip: str, bucket: str, limit: int, window_sec: int) -> int:\n","    key = f\"rl:{bucket}:{ip}\"\n","    try:\n","        n = int(r.eval(_LUA, 1, key, int(window_sec)))\n","        return n\n","    except Exception:\n","        return 0  # fail-open\n","PY\n","\n","cat > \"$API/app/queue.py\" <<'PY'\n","from redis import Redis\n","from rq import Queue\n","from .config import REDIS_URL\n","\n","redis_conn = Redis.from_url(REDIS_URL)\n","q = Queue(\"audits\", connection=redis_conn, default_timeout=900)\n","PY\n","\n","cat > \"$API/app/crawler.py\" <<'PY'\n","import re, asyncio\n","from urllib.parse import urljoin, urlparse, urldefrag\n","from urllib.robotparser import RobotFileParser\n","import aiohttp\n","from bs4 import BeautifulSoup\n","\n","SKIP_EXT = re.compile(r\".*\\.(pdf|zip|rar|7z|png|jpg|jpeg|webp|gif|svg|mp4|mp3|woff|woff2|ttf|eot)(\\?.*)?$\", re.I)\n","\n","def normalize_url(url: str) -> str:\n","    url, _ = urldefrag(url)\n","    p = urlparse(url)\n","    scheme = (p.scheme or \"https\").lower()\n","    netloc = (p.netloc or \"\").lower()\n","    path = p.path or \"/\"\n","    if path != \"/\" and path.endswith(\"/\"):\n","        path = path[:-1]\n","    return f\"{scheme}://{netloc}{path}\" + (f\"?{p.query}\" if p.query else \"\")\n","\n","def same_host(seed: str, u: str) -> bool:\n","    return urlparse(seed).netloc.lower() == urlparse(u).netloc.lower()\n","\n","async def fetch_html(session, url, timeout=12):\n","    try:\n","        async with session.get(url, timeout=aiohttp.ClientTimeout(total=timeout), allow_redirects=True) as r:\n","            hdrs = {k.lower(): v for k, v in r.headers.items()}\n","            ct = (hdrs.get(\"content-type\",\"\") or \"\").lower()\n","            final = str(r.url)\n","            if \"text/html\" not in ct:\n","                return r.status, None, 0, hdrs, final\n","            html = await r.text(errors=\"ignore\")\n","            return r.status, html, len(html.encode(\"utf-8\", errors=\"ignore\")), hdrs, final\n","    except Exception:\n","        return None, None, 0, {}, url\n","\n","async def crawl_bfs(seed_url: str, max_pages=20, max_depth=2, obey_robots=True, concurrency=6, ua=\"BrandOSAuditBot/1.0\"):\n","    seed = normalize_url(seed_url)\n","\n","    rp = None\n","    if obey_robots:\n","        rp = RobotFileParser()\n","        try:\n","            rp.set_url(urljoin(seed, \"/robots.txt\"))\n","            rp.read()\n","        except Exception:\n","            rp = None\n","\n","    visited = set([seed])\n","    q = [(seed, 0)]\n","    out = []\n","    sem = asyncio.Semaphore(concurrency)\n","\n","    async with aiohttp.ClientSession(headers={\"User-Agent\": ua}) as session:\n","        async def work(url, depth):\n","            async with sem:\n","                if rp and not rp.can_fetch(ua, url):\n","                    return {\"url\": url, \"depth\": depth, \"status_code\": None, \"title\": None, \"html_size\": 0,\n","                            \"blocked_by_robots\": True, \"links\": [], \"headers\": {}, \"final_url\": url, \"html\": None}\n","                st, html, size, hdrs, final = await fetch_html(session, url)\n","                title, links = None, []\n","                if html:\n","                    soup = BeautifulSoup(html, \"html.parser\")\n","                    if soup.title and soup.title.string:\n","                        title = soup.title.string.strip()\n","                    for a in soup.select(\"a[href]\"):\n","                        href = (a.get(\"href\") or \"\").strip()\n","                        if not href or href.startswith((\"#\",\"mailto:\",\"tel:\",\"javascript:\")):\n","                            continue\n","                        absu = normalize_url(urljoin(final, href))\n","                        if not same_host(seed, absu):\n","                            continue\n","                        if SKIP_EXT.match(absu):\n","                            continue\n","                        links.append(absu)\n","                return {\"url\": url, \"depth\": depth, \"status_code\": st, \"title\": title, \"html_size\": size,\n","                        \"blocked_by_robots\": False, \"links\": links, \"headers\": hdrs, \"final_url\": final, \"html\": html}\n","\n","        while q and len(out) < max_pages:\n","            batch = []\n","            while q and len(batch) < concurrency and len(out) + len(batch) < max_pages:\n","                batch.append(q.pop(0))\n","            done = await asyncio.gather(*[work(u, d) for (u, d) in batch])\n","            for item in done:\n","                out.append(item)\n","                if item[\"depth\"] >= max_depth:\n","                    continue\n","                for link in item[\"links\"]:\n","                    if link not in visited and len(visited) < max_pages * 40:\n","                        visited.add(link)\n","                        q.append((link, item[\"depth\"] + 1))\n","    return out\n","PY\n","\n","cat > \"$API/app/checks.py\" <<'PY'\n","from bs4 import BeautifulSoup\n","from urllib.parse import urljoin\n","import aiohttp\n","from .config import PAGESPEED_API_KEY\n","\n","def finding(code, title, category, severity, confidence, effort, impact, recommendation, evidence=None):\n","    return {\"code\":code,\"title\":title,\"category\":category,\"severity\":severity,\"confidence\":float(confidence),\n","            \"effort\":effort,\"impact\":impact if isinstance(impact,list) else [impact],\n","            \"recommendation\":recommendation,\"evidence\":evidence or {}}\n","\n","SEV_WEIGHT = {\"Critical\":20, \"High\":12, \"Medium\":6, \"Low\":2}\n","def clamp(x, lo=0, hi=100): return max(lo, min(hi, x))\n","\n","def scores_from_findings(findings):\n","    cats = {}\n","    for f in findings:\n","        cat = f[\"category\"]\n","        cats.setdefault(cat, 100.0)\n","        cats[cat] -= SEV_WEIGHT.get(f[\"severity\"], 2) * float(f.get(\"confidence\", 1.0))\n","    out = {}\n","    for cat, score in cats.items():\n","        confs = [float(f.get(\"confidence\", 1.0)) for f in findings if f[\"category\"] == cat]\n","        conf = sum(confs)/len(confs) if confs else 0.8\n","        out[cat] = {\"score\": int(clamp(round(score))), \"confidence\": float(clamp(conf*100,0,100))/100.0}\n","    return out\n","\n","def overall_from_categories(categories):\n","    vals = [v[\"score\"] for v in categories.values() if isinstance(v, dict) and \"score\" in v]\n","    return int(round(sum(vals)/len(vals))) if vals else 100\n","\n","def seo_checks(final_url, headers, html):\n","    soup = BeautifulSoup(html or \"\", \"html.parser\")\n","    out = []\n","\n","    canon_tag = soup.find(\"link\", rel=lambda x: x and \"canonical\" in x.lower())\n","    canon = canon_tag.get(\"href\").strip() if canon_tag and canon_tag.get(\"href\") else \"\"\n","    if not canon:\n","        out.append(finding(\"SEO_MISSING_CANONICAL\",\"Missing canonical tag\",\"SEO\",\"High\",0.95,\"Easy\",\"SEO\",\n","                           \"Add <link rel='canonical'> pointing to the preferred URL.\",{\"page\":final_url}))\n","\n","    robots_meta_tag = soup.find(\"meta\", attrs={\"name\":\"robots\"})\n","    robots_meta = (robots_meta_tag.get(\"content\") or \"\").strip() if robots_meta_tag else \"\"\n","    xrobots = headers.get(\"x-robots-tag\",\"\")\n","    if \"noindex\" in f\"{robots_meta} {xrobots}\".lower():\n","        out.append(finding(\"SEO_NOINDEX_DETECTED\",\"Noindex detected\",\"SEO\",\"Critical\",0.9,\"Easy\",\"SEO\",\n","                           \"Remove 'noindex' if indexing is intended.\",{\"robots_meta\":robots_meta,\"x_robots_tag\":xrobots,\"page\":final_url}))\n","\n","    def meta(prop=None, name=None):\n","        if prop:\n","            t = soup.find(\"meta\", attrs={\"property\": prop})\n","            return (t.get(\"content\") or \"\").strip() if t else \"\"\n","        if name:\n","            t = soup.find(\"meta\", attrs={\"name\": name})\n","            return (t.get(\"content\") or \"\").strip() if t else \"\"\n","        return \"\"\n","\n","    missing = []\n","    if not meta(prop=\"og:title\"): missing.append(\"og:title\")\n","    if not meta(prop=\"og:description\"): missing.append(\"og:description\")\n","    if not meta(prop=\"og:image\"): missing.append(\"og:image\")\n","    if not meta(name=\"twitter:card\"): missing.append(\"twitter:card\")\n","    if missing:\n","        out.append(finding(\"SEO_MISSING_SOCIAL_META\",\"Missing social meta\",\"SEO\",\"Low\",0.9,\"Easy\",[\"SEO\",\"UX\"],\n","                           \"Add OpenGraph and Twitter Card tags.\",{\"missing\":missing,\"page\":final_url}))\n","    return out\n","\n","async def sitemap_checks(seed_url):\n","    robots = urljoin(seed_url, \"/robots.txt\")\n","    txt = \"\"\n","    try:\n","        async with aiohttp.ClientSession() as s:\n","            async with s.get(robots, timeout=aiohttp.ClientTimeout(total=12)) as r:\n","                if r.status < 400:\n","                    txt = await r.text(errors=\"ignore\")\n","    except Exception:\n","        txt = \"\"\n","\n","    sitemaps = []\n","    for line in txt.splitlines():\n","        if line.lower().startswith(\"sitemap:\"):\n","            u = line.split(\":\", 1)[1].strip()\n","            if u: sitemaps.append(u)\n","\n","    async def check(path):\n","        u = urljoin(seed_url, path)\n","        try:\n","            async with aiohttp.ClientSession() as s:\n","                async with s.get(u, timeout=aiohttp.ClientTimeout(total=12)) as r:\n","                    if r.status < 400:\n","                        body = await r.text(errors=\"ignore\")\n","                        if \"<urlset\" in body or \"<sitemapindex\" in body:\n","                            return u\n","        except Exception:\n","            return None\n","        return None\n","\n","    if not sitemaps:\n","        for p in (\"/sitemap.xml\",\"/sitemap_index.xml\"):\n","            got = await check(p)\n","            if got: sitemaps.append(got)\n","\n","    findings = []\n","    if not sitemaps:\n","        findings.append(finding(\"SEO_SITEMAP_NOT_FOUND\",\"Sitemap not detected\",\"SEO\",\"Medium\",0.75,\"Medium\",\"SEO\",\n","                               \"Create and reference an XML sitemap and submit to Search Console.\",{\"robots_url\": robots}))\n","    return findings\n","\n","def security_checks(final_url, headers):\n","    out = []\n","    if final_url.lower().startswith(\"https://\") and \"strict-transport-security\" not in headers:\n","        out.append(finding(\"SEC_MISSING_HSTS\",\"HSTS missing\",\"Security\",\"High\",0.95,\"Easy\",\"Security\",\n","                           \"Enable Strict-Transport-Security (HSTS).\",{\"page\":final_url}))\n","    if \"content-security-policy\" not in headers:\n","        out.append(finding(\"SEC_MISSING_CSP\",\"CSP missing\",\"Security\",\"High\",0.9,\"Hard\",\"Security\",\n","                           \"Add a Content-Security-Policy header (start report-only).\",{\"page\":final_url}))\n","    return out\n","\n","def a11y_checks(final_url, html):\n","    soup = BeautifulSoup(html or \"\", \"html.parser\")\n","    out = []\n","    html_tag = soup.find(\"html\")\n","    if not (html_tag and (html_tag.get(\"lang\") or \"\").strip()):\n","        out.append(finding(\"A11Y_MISSING_LANG\",\"Missing lang on <html>\",\"Accessibility\",\"Medium\",0.9,\"Easy\",[\"Accessibility\",\"SEO\"],\n","                           \"Add <html lang='...'>.\",{\"page\":final_url}))\n","    h1 = soup.find(\"h1\")\n","    if not h1 or not (h1.get_text(strip=True) or \"\"):\n","        out.append(finding(\"A11Y_MISSING_H1\",\"Missing or empty H1\",\"Accessibility\",\"Medium\",0.85,\"Easy\",[\"Accessibility\",\"SEO\",\"UX\"],\n","                           \"Add one descriptive <h1>.\",{\"page\":final_url}))\n","    return out\n","\n","async def run_pagespeed(url, strategy, key):\n","    endpoint = \"https://www.googleapis.com/pagespeedonline/v5/runPagespeed\"\n","    cats = [\"performance\",\"accessibility\",\"seo\",\"best-practices\"]\n","    cat_q = \"&\".join([f\"category={c}\" for c in cats])\n","    full = f\"{endpoint}?url={url}&strategy={strategy}&key={key}&{cat_q}\"\n","    try:\n","        async with aiohttp.ClientSession() as s:\n","            async with s.get(full, timeout=aiohttp.ClientTimeout(total=45)) as r:\n","                if r.status >= 400:\n","                    return None\n","                return await r.json()\n","    except Exception:\n","        return None\n","\n","def parse_pagespeed(js):\n","    try:\n","        lh = js.get(\"lighthouseResult\", {})\n","        cats = lh.get(\"categories\", {})\n","        def score(k):\n","            v = cats.get(k, {}).get(\"score\", None)\n","            return None if v is None else int(round(v * 100))\n","        return {\"Performance\": score(\"performance\"), \"Accessibility\": score(\"accessibility\"), \"SEO\": score(\"seo\"), \"Best Practices\": score(\"best-practices\")}\n","    except Exception:\n","        return None\n","\n","async def run_all(seed_url, final_url, headers, html):\n","    findings = []\n","    if html:\n","        findings += seo_checks(final_url, headers, html)\n","        findings += await sitemap_checks(seed_url)\n","        findings += security_checks(final_url, headers)\n","        findings += a11y_checks(final_url, html)\n","\n","    psi_scores = None\n","    if PAGESPEED_API_KEY:\n","        mob = await run_pagespeed(final_url, \"mobile\", PAGESPEED_API_KEY)\n","        psi_scores = parse_pagespeed(mob) if mob else None\n","        if psi_scores and psi_scores.get(\"Performance\") is not None and psi_scores[\"Performance\"] < 60:\n","            findings.append(finding(\"PERF_LOW_MOBILE\",\"Low Lighthouse performance (mobile)\",\"Performance\",\n","                                    \"High\" if psi_scores[\"Performance\"] < 40 else \"Medium\",0.85,\"Hard\",[\"Performance\",\"UX\",\"SEO\"],\n","                                    \"Optimize JS/CSS, images, caching/compression; fix CWV.\",\n","                                    {\"performance_score\": psi_scores[\"Performance\"]}))\n","\n","    categories = scores_from_findings(findings) if findings else {\n","        \"SEO\":{\"score\":90,\"confidence\":0.7},\n","        \"Security\":{\"score\":90,\"confidence\":0.7},\n","        \"Performance\":{\"score\":90,\"confidence\":0.7},\n","        \"Accessibility\":{\"score\":90,\"confidence\":0.7},\n","    }\n","    overall = overall_from_categories(categories)\n","    return overall, categories, findings, psi_scores\n","PY\n","\n","cat > \"$API/app/templates/report.html\" <<'HTML'\n","<!doctype html><html><head><meta charset=\"utf-8\"/><title>Audit Report</title>\n","<style>\n","body{font-family:Arial,sans-serif;margin:28px}\n",".muted{color:#666;font-size:12px}\n",".card{border:1px solid #ddd;border-radius:10px;padding:14px;margin:14px 0}\n",".kpi{font-size:28px;font-weight:700}\n","table{width:100%;border-collapse:collapse;margin-top:10px}\n","th,td{border-bottom:1px solid #eee;text-align:left;padding:8px 6px;vertical-align:top}\n",".sev-Critical{color:#b00020;font-weight:700}.sev-High{color:#c06a00;font-weight:700}\n",".sev-Medium{color:#555;font-weight:700}.sev-Low{color:#666}\n","code{background:#f6f6f6;padding:2px 4px;border-radius:4px}\n","</style></head><body>\n","<h1>Website Audit Report</h1>\n","<div class=\"muted\">URL: {{ url }}<br/>Audit ID: {{ audit_id }}<br/>Generated: {{ generated_at }}</div>\n","\n","<div class=\"card\">\n","  <div class=\"muted\">Overall Score</div>\n","  <div class=\"kpi\">{{ overall_score }}</div>\n","  <div class=\"muted\">Categories:</div>\n","  <ul>\n","    {% for k,v in categories.items() %}\n","      <li><b>{{k}}</b>: {{v.score}} (conf {{ \"%.2f\"|format(v.confidence) }})</li>\n","    {% endfor %}\n","  </ul>\n","</div>\n","\n","<div class=\"card\">\n","<h2>Findings</h2>\n","<table>\n","<thead><tr><th style=\"width:120px\">Severity</th><th>Issue</th><th style=\"width:120px\">Effort</th></tr></t