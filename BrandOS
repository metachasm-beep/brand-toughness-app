{"cells":[{"cell_type":"code","source":["%%bash\n","set -e\n","\n","# System deps\n","apt-get update -y >/dev/null\n","apt-get install -y redis-server curl >/dev/null\n","\n","# Python deps\n","pip -q install --upgrade pip\n","pip -q install fastapi uvicorn[standard] python-jose pydantic sqlalchemy redis rq requests aiohttp beautifulsoup4 jinja2 playwright\n","\n","# Playwright browser (Chromium)\n","python -m playwright install --with-deps chromium >/dev/null\n","\n","# Node (for Next.js) - Colab usually has Node, but ensure it's there\n","node -v >/dev/null 2>&1 || (curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null && apt-get install -y nodejs >/dev/null)\n","node -v\n","npm -v\n","\n","# ngrok binary\n","mkdir -p /content/bin\n","cd /content/bin\n","if [ ! -f ngrok ]; then\n","  curl -sSL https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-amd64.tgz | tar -xz\n","  chmod +x ngrok\n","fi\n","\n","echo \"✅ Installed deps. ngrok at /content/bin/ngrok\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NAQABW9KcZS8","executionInfo":{"status":"ok","timestamp":1772369366288,"user_tz":-330,"elapsed":41996,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"bc898c88-56e3-4b54-f78a-473d1dbdf063"},"execution_count":261,"outputs":[{"output_type":"stream","name":"stdout","text":["v20.20.0\n","10.8.2\n","✅ Installed deps. ngrok at /content/bin/ngrok\n"]},{"output_type":"stream","name":"stderr","text":["W: Skipping acquire of configured file 'main/source/Sources' as repository 'https://r2u.stat.illinois.edu/ubuntu jammy InRelease' does not seem to provide it (sources.list entry misspelt?)\n","W: Skipping acquire of configured file 'main/source/Sources' as repository 'https://r2u.stat.illinois.edu/ubuntu jammy InRelease' does not seem to provide it (sources.list entry misspelt?)\n"]}]},{"cell_type":"code","source":["import os\n","\n","# Colab Secrets appear in os.environ automatically once added in the Secrets UI