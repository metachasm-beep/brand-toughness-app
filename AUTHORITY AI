{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"mount_file_id":"19-TPVKzjePxuIQNJVrZi5NgeZgfpg5vF","authorship_tag":"ABX9TyPm/ioYO9HlRoKiEJNDTSFh"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["!pip -q install fastapi uvicorn streamlit pyngrok httpx beautifulsoup4 lxml plotly bcrypt pyjwt requests"],"metadata":{"id":"bq7xTWnePdFI","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1772350747729,"user_tz":-330,"elapsed":10134,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"26d470ff-1fc2-4f04-be1b-10508eea64ec"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m9.1/9.1 MB\u001b[0m \u001b[31m55.3 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m278.2/278.2 kB\u001b[0m \u001b[31m15.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m6.9/6.9 MB\u001b[0m \u001b[31m90.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h"]}]},{"cell_type":"code","source":["import os\n","\n","# REQUIRED\n","os.environ[\"NGROK_AUTH_TOKEN\"] = \"3AJQ7M3vTRmVo14hbbKfc0afLHq_5MxQ9XFtDU4d9CJvW8NSg\"\n","\n","# OPTIONAL (recommended)\n","# os.environ[\"PAGESPEED_API_KEY\"] = \"AIzaSyAHXuXbDF7ZsJO7w2fgA7iLF9vC4ydpUjg\"\n","# os.environ[\"COHERE_API_KEY\"] = \"CcneO0AaCV5HLWp6PbldIZS8LaWzLmnxD8pZGS4m\"\n","\n","# JWT secret (can keep default for demo)\n","os.environ.setdefault(\"BRANDOS_JWT_SECRET\", \"brandos-dev-secret\")\n","\n","print(\"Environment ready\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mHPRlfI0PiDj","executionInfo":{"status":"ok","timestamp":1772350747746,"user_tz":-330,"elapsed":10,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"4af9d2dd-f3f8-46d9-9f64-81442fb87a44"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Environment ready\n"]}]},{"cell_type":"code","source":["%%writefile backend.py\n","import os, re, json, time, uuid, base64, datetime, threading\n","from typing import Optional, Dict, Any, List, Tuple\n","\n","import bcrypt\n","import jwt\n","import requests\n","import httpx\n","from bs4 import BeautifulSoup\n","from fastapi import FastAPI, HTTPException, Depends, Header\n","from pydantic import BaseModel\n","import sqlite3\n","\n","APP_NAME = \"BrandOS\"\n","DB_PATH = os.environ.get(\"BRANDOS_DB\", \"brandos.db\")\n","\n","JWT_SECRET = os.environ.get(\"JWT_SECRET\", \"dev-secret-change-me\")\n","JWT_ALG = \"HS256\"\n","ACCESS_TTL_MIN = int(os.environ.get(\"ACCESS_TTL_MIN\", \"30\"))\n","REFRESH_TTL_DAYS = int(os.environ.get(\"REFRESH_TTL_DAYS\", \"14\"))\n","\n","PAGESPEED_API_KEY = os.environ.get(\"PAGESPEED_API_KEY\")  # optional\n","\n","# ---------------- DB ----------------\n","CURRENT_SCHEMA_VERSION = 3\n","\n","def db():\n","    conn = sqlite3.connect(DB_PATH, check_same_thread=False)\n","    conn.row_factory = sqlite3.Row\n","    return conn\n","\n","def now_iso():\n","    return datetime.datetime.utcnow().isoformat()\n","\n","def table_columns(cur, table: str) -> List[str]:\n","    try:\n","        rows = cur.execute(f\"PRAGMA table_info({table})\").fetchall()\n","        return [r[1] for r in rows]  # name\n","    except:\n","        return []\n","\n","def ensure_schema():\n","    conn = db()\n","    cur = conn.cursor()\n","\n","    cur.execute(\"\"\"\n","    CREATE TABLE IF NOT EXISTS schema_meta(\n","      k TEXT PRIMARY KEY,\n","      v TEXT NOT NULL\n","    )\n","    \"\"\")\n","\n","    def get_schema_version() -> int:\n","        row = cur.execute(\"SELECT v FROM schema_meta WHERE k='schema_version'\").fetchone()\n","        return int(row[\"v\"]) if row else 0\n","\n","    def set_schema_version(v: int):\n","        cur.execute(\"INSERT OR REPLACE INTO schema_meta(k,v) VALUES('schema_version',?)\", (str(v),))\n","\n","    # If tables exist but columns are wrong (old DB), wipe safely (Colab-friendly).\n","    # This avoids the \"no such column\" / \"table users has no column id\" class of failures.\n","    existing_users_cols = table_columns(cur, \"users\")\n","    existing_audits_cols = table_columns(cur, \"audits\")\n","\n","    bad_users = existing_users_cols and (\"id\" not in existing_users_cols or \"org_id\" not in existing_users_cols)\n","    bad_audits = existing_audits_cols and (\"payload_json\" not in existing_audits_cols or \"categories_json\" not in existing_audits_cols)\n","\n","    schema_version = get_schema_version()\n","    if schema_version != CURRENT_SCHEMA_VERSION or bad_users or bad_audits:\n","        # Drop old tables (demo safe)\n","        cur.execute(\"DROP TABLE IF EXISTS refresh_tokens\")\n","        cur.execute(\"DROP TABLE IF EXISTS audits\")\n","        cur.execute(\"DROP TABLE IF EXISTS users\")\n","        cur.execute(\"DROP TABLE IF EXISTS organizations\")\n","        conn.commit()\n","        cur.execute(\"DELETE FROM schema_meta WHERE k='schema_version'\")\n","        conn.commit()\n","\n","    # Create fresh schema\n","    cur.execute(\"\"\"\n","    CREATE TABLE IF NOT EXISTS organizations(\n","      id TEXT PRIMARY KEY,\n","      slug TEXT UNIQUE NOT NULL,\n","      name TEXT NOT NULL,\n","      created_at TEXT NOT NULL\n","    )\n","    \"\"\")\n","\n","    cur.execute(\"\"\"\n","    CREATE TABLE IF NOT EXISTS users(\n","      id TEXT PRIMARY KEY,\n","      org_id TEXT NOT NULL,\n","      email TEXT NOT NULL,\n","      password_hash TEXT NOT NULL,\n","      role TEXT NOT NULL,\n","      created_at TEXT NOT NULL,\n","      UNIQUE(org_id, email),\n","      FOREIGN KEY(org_id) REFERENCES organizations(id)\n","    )\n","    \"\"\")\n","\n","    cur.execute(\"\"\"\n","    CREATE TABLE IF NOT EXISTS refresh_tokens(\n","      id TEXT PRIMARY KEY,\n","      user_id TEXT NOT NULL,\n","      token TEXT NOT NULL,\n","      expires_at TEXT NOT NULL,\n","      created_at TEXT NOT NULL,\n","      FOREIGN KEY(user_id) REFERENCES users(id)\n","    )\n","    \"\"\")\n","\n","    cur.execute(\"\"\"\n","    CREATE TABLE IF NOT EXISTS audits(\n","      id TEXT PRIMARY KEY,\n","      org_id TEXT NOT NULL,\n","      user_id TEXT NOT NULL,\n","      url TEXT NOT NULL,\n","      strategy TEXT NOT NULL,\n","      status TEXT NOT NULL,\n","      step TEXT NOT NULL,\n","      progress INTEGER NOT NULL,\n","      error TEXT,\n","      overall INTEGER NOT NULL,\n","      categories_json TEXT NOT NULL,\n","      payload_json TEXT NOT NULL,\n","      created_at TEXT NOT NULL,\n","      updated_at TEXT NOT NULL,\n","      FOREIGN KEY(org_id) REFERENCES organizations(id),\n","      FOREIGN KEY(user_id) REFERENCES users(id)\n","    )\n","    \"\"\")\n","\n","    set_schema_version(CURRENT_SCHEMA_VERSION)\n","    conn.commit()\n","    conn.close()\n","\n","def b64_hash(pw: str) -> str:\n","    h = bcrypt.hashpw(pw.encode(\"utf-8\"), bcrypt.gensalt())\n","    return base64.b64encode(h).decode(\"utf-8\")\n","\n","def b64_check(pw: str, stored_b64: str) -> bool:\n","    try:\n","        h = base64.b64decode(stored_b64.encode(\"utf-8\"))\n","        return bcrypt.checkpw(pw.encode(\"utf-8\"), h)\n","    except:\n","        return False\n","\n","def seed_demo():\n","    conn = db()\n","    cur = conn.cursor()\n","\n","    org = cur.execute(\"SELECT * FROM organizations WHERE slug=?\", (\"demo\",)).fetchone()\n","    if not org:\n","        org_id = str(uuid.uuid4())\n","        cur.execute(\"INSERT INTO organizations(id,slug,name,created_at) VALUES (?,?,?,?)\",\n","                    (org_id, \"demo\", \"Demo Workspace\", now_iso()))\n","    else:\n","        org_id = org[\"id\"]\n","\n","    def ensure_user(email: str, password: str, role: str):\n","        row = cur.execute(\"SELECT * FROM users WHERE org_id=? AND email=?\", (org_id, email)).fetchone()\n","        if not row:\n","            cur.execute(\"\"\"INSERT INTO users(id,org_id,email,password_hash,role,created_at)\n","                           VALUES (?,?,?,?,?,?)\"\"\",\n","                        (str(uuid.uuid4()), org_id, email, b64_hash(password), role, now_iso()))\n","\n","    ensure_user(\"owner@demo.com\", \"owner123\", \"OWNER\")\n","    ensure_user(\"admin@demo.com\", \"admin123\", \"ADMIN\")\n","\n","    conn.commit()\n","    conn.close()\n","\n","# ---------------- Auth ----------------\n","def make_access_token(user_id: str, org_id: str, role: str) -> str:\n","    exp = datetime.datetime.utcnow() + datetime.timedelta(minutes=ACCESS_TTL_MIN)\n","    payload = {\"sub\": user_id, \"org\": org_id, \"role\": role, \"exp\": exp}\n","    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)\n","\n","def make_refresh_token() -> str:\n","    return base64.urlsafe_b64encode(os.urandom(48)).decode(\"utf-8\").rstrip(\"=\")\n","\n","def verify_access_token(token: str) -> dict:\n","    try:\n","        return jwt.decode(token, JWT_SECRET, algorithms=[JWT_ALG])\n","    except jwt.ExpiredSignatureError:\n","        raise HTTPException(401, \"Token expired\")\n","    except Exception:\n","        raise HTTPException(401, \"Invalid token\")\n","\n","class Ctx(BaseModel):\n","    user_id: str\n","    org_id: str\n","    role: str\n","\n","def get_ctx(authorization: Optional[str] = Header(None)) -> Ctx:\n","    if not authorization or not authorization.lower().startswith(\"bearer \"):\n","        raise HTTPException(401, \"Missing bearer token\")\n","    token = authorization.split(\" \", 1)[1].strip()\n","    data = verify_access_token(token)\n","    return Ctx(user_id=data[\"sub\"], org_id=data[\"org\"], role=data.get(\"role\",\"MEMBER\"))\n","\n","def get_user_and_org(ctx: Ctx):\n","    conn = db()\n","    cur = conn.cursor()\n","    user = cur.execute(\"SELECT * FROM users WHERE id=? AND org_id=?\", (ctx.user_id, ctx.org_id)).fetchone()\n","    org = cur.execute(\"SELECT * FROM organizations WHERE id=?\", (ctx.org_id,)).fetchone()\n","    conn.close()\n","    if not user or not org:\n","        raise HTTPException(401, \"Invalid session\")\n","    return dict(user), dict(org)\n","\n","# ---------------- Audit helpers ----------------\n","def clamp(x: float) -> int:\n","    try:\n","        x = float(x)\n","    except:\n","        x = 0\n","    return int(max(0, min(100, round(x))))\n","\n","def normalize_url(u: str) -> str:\n","    u = (u or \"\").strip()\n","    if not u:\n","        return \"\"\n","    if not re.match(r\"^https?://\", u, re.I):\n","        u = \"https://\" + u\n","    return u\n","\n","def fetch_ttfb_and_html(url: str, timeout=15) -> Tuple[float, int, str, Dict[str,str]]:\n","    headers = {\"User-Agent\": f\"{APP_NAME}/1.0 (audit bot)\", \"Accept\": \"text/html,application/xhtml+xml\"}\n","    t0 = time.time()\n","    r = requests.get(url, headers=headers, timeout=timeout, allow_redirects=True)\n","    ttfb = time.time() - t0\n","    return (ttfb, r.status_code, r.text[:2_000_000], dict(r.headers))\n","\n","def soup_text(soup: BeautifulSoup) -> str:\n","    for t in soup([\"script\",\"style\",\"noscript\"]):\n","        t.decompose()\n","    return \" \".join(soup.get_text(\" \").split())\n","\n","def detect_links(soup: BeautifulSoup, base_url: str) -> Tuple[int,int,List[str]]:\n","    internal = 0\n","    external = 0\n","    urls = []\n","    base_host = re.sub(r\"^https?://\", \"\", base_url).split(\"/\")[0].lower()\n","    for a in soup.find_all(\"a\", href=True):\n","        href = a.get(\"href\",\"\").strip()\n","        if not href or href.startswith(\"#\") or href.startswith(\"mailto:\") or href.startswith(\"tel:\"):\n","            continue\n","        if href.startswith(\"/\"):\n","            u = base_url.rstrip(\"/\") + href\n","            internal += 1\n","            urls.append(u)\n","        elif href.startswith(\"http\"):\n","            host = re.sub(r\"^https?://\", \"\", href).split(\"/\")[0].lower()\n","            if base_host and host.endswith(base_host):\n","                internal += 1\n","                urls.append(href)\n","            else:\n","                external += 1\n","        else:\n","            internal += 1\n","    # de-dup\n","    out = []\n","    seen = set()\n","    for u in urls:\n","        if u not in seen:\n","            out.append(u)\n","            seen.add(u)\n","    return internal, external, out\n","\n","def pick_extra_pages(base_url: str, soup: BeautifulSoup) -> List[str]:\n","    candidates = []\n","    preferred = [\"about\",\"services\",\"service\",\"pricing\",\"plans\",\"blog\",\"contact\",\"work\",\"portfolio\",\"case\"]\n","    for a in soup.find_all(\"a\", href=True):\n","        href = a.get(\"href\",\"\").strip()\n","        if not href:\n","            continue\n","        h = href.lower()\n","        if any(p in h for p in preferred):\n","            if href.startswith(\"/\"):\n","                candidates.append(base_url.rstrip(\"/\") + href)\n","            elif href.startswith(\"http\"):\n","                candidates.append(href)\n","    # de-dup preserve order\n","    out = []\n","    seen = set()\n","    for u in candidates:\n","        if u not in seen:\n","            out.append(u); seen.add(u)\n","    return out[:8]\n","\n","async def fetch_pages_concurrent(urls: List[str], timeout=12) -> List[Dict[str,Any]]:\n","    out = []\n","    headers = {\"User-Agent\": f\"{APP_NAME}/1.0 (audit bot)\", \"Accept\": \"text/html,application/xhtml+xml\"}\n","    async with httpx.AsyncClient(follow_redirects=True, headers=headers, timeout=timeout) as client:\n","        tasks = [client.get(u) for u in urls]\n","        results = await httpx.AsyncClient.gather(*tasks) if hasattr(httpx.AsyncClient, \"gather\") else None\n","\n","    # Fallback if gather not present (safe path)\n","    if results is None:\n","        async with httpx.AsyncClient(follow_redirects=True, headers=headers, timeout=timeout) as client2:\n","            for u in urls:\n","                try:\n","                    r = await client2.get(u)\n","                    results = (results or []) + [r]\n","                except:\n","                    results = (results or []) + [None]\n","\n","    for u, r in zip(urls, results):\n","        if r is None:\n","            continue\n","        try:\n","            html = r.text[:800_000]\n","            soup = BeautifulSoup(html, \"html.parser\")\n","            txt = soup_text(soup)[:25000]\n","            title = (soup.title.string.strip() if soup.title and soup.title.string else \"\")\n","            out.append({\"url\": u, \"status\": r.status_code, \"title\": title, \"text\": txt})\n","        except:\n","            continue\n","    return out[:8]\n","\n","def pagespeed_run(url: str, strategy: str=\"mobile\") -> Dict[str,Any]:\n","    # Returns {\"available\": bool, \"scores\": {...}, \"raw\": {...}, \"error\": \"...\"}\n","    if not PAGESPEED_API_KEY:\n","        return {\"available\": False, \"scores\": {}, \"raw\": {}, \"error\": \"PAGESPEED_API_KEY missing\"}\n","\n","    endpoint = \"https://www.googleapis.com/pagespeedonline/v5/runPagespeed\"\n","    params = [\n","        (\"url\", url),\n","        (\"strategy\", strategy),\n","        (\"category\",\"performance\"),\n","        (\"category\",\"accessibility\"),\n","        (\"category\",\"best-practices\"),\n","        (\"category\",\"seo\"),\n","        (\"key\", PAGESPEED_API_KEY),\n","    ]\n","    try:\n","        r = requests.get(endpoint, params=params, timeout=45)\n","        if r.status_code == 429:\n","            return {\"available\": False, \"scores\": {}, \"raw\": {}, \"error\": \"rate_limited\"}\n","        r.raise_for_status()\n","        data = r.json()\n","        cats = (data.get(\"lighthouseResult\",{}).get(\"categories\",{}) or {})\n","        scores = {\n","            \"performance\": clamp((cats.get(\"performance\",{}).get(\"score\") or 0) * 100),\n","            \"accessibility\": clamp((cats.get(\"accessibility\",{}).get(\"score\") or 0) * 100),\n","            \"best_practices\": clamp((cats.get(\"best-practices\",{}).get(\"score\") or 0) * 100),\n","            \"seo\": clamp((cats.get(\"seo\",{}).get(\"score\") or 0) * 100),\n","        }\n","        return {\"available\": True, \"scores\": scores, \"raw\": data}\n","    except Exception as e:\n","        return {\"available\": False, \"scores\": {}, \"raw\": {}, \"error\": str(e)[:200]}\n","\n","def seo_heuristics(soup: BeautifulSoup) -> Dict[str,Any]:\n","    title = (soup.title.string.strip() if soup.title and soup.title.string else \"\")\n","    desc = \"\"\n","    md = soup.find(\"meta\", attrs={\"name\":\"description\"})\n","    if md and md.get(\"content\"):\n","        desc = md[\"content\"].strip()\n","    h1 = soup.find(\"h1\")\n","    h1txt = h1.get_text(\" \").strip() if h1 else \"\"\n","    imgs = soup.find_all(\"img\")\n","    img_total = len(imgs)\n","    img_alt = sum(1 for im in imgs if (im.get(\"alt\") or \"\").strip())\n","    canonical = soup.find(\"link\", rel=lambda x: x and \"canonical\" in x.lower())\n","    canon_ok = bool(canonical and canonical.get(\"href\"))\n","    return {\n","        \"title_len\": len(title),\n","        \"has_title\": bool(title),\n","        \"desc_len\": len(desc),\n","        \"has_desc\": bool(desc),\n","        \"has_h1\": bool(h1txt),\n","        \"h1\": h1txt[:120],\n","        \"img_total\": img_total,\n","        \"img_alt_ratio\": (img_alt / img_total) if img_total else 0,\n","        \"canonical\": canon_ok,\n","    }\n","\n","def score_from_ttfb(ttfb: float) -> int:\n","    # ttfb <=0.3 => 95, <=0.8 => 80, <=1.5 => 60, <=2.5 => 40 else 20\n","    if ttfb <= 0.3: return 95\n","    if ttfb <= 0.8: return 80\n","    if ttfb <= 1.5: return 60\n","    if ttfb <= 2.5: return 40\n","    return 20\n","\n","def score_https(url: str, hdrs: Dict[str,str]) -> int:\n","    s = 0\n","    if url.lower().startswith(\"https://\"): s += 60\n","    hsts = hdrs.get(\"strict-transport-security\",\"\")\n","    csp = hdrs.get(\"content-security-policy\",\"\")\n","    xcto = hdrs.get(\"x-content-type-options\",\"\")\n","    if hsts: s += 15\n","    if csp: s += 15\n","    if \"nosniff\" in xcto.lower(): s += 10\n","    return clamp(s)\n","\n","def best_practices_score(hdrs: Dict[str,str], soup: BeautifulSoup) -> int:\n","    s = 60\n","    if \"x-frame-options\" in hdrs: s += 10\n","    if \"referrer-policy\" in hdrs: s += 10\n","    if \"permissions-policy\" in hdrs: s += 10\n","    # basic: viewport meta exists\n","    vp = soup.find(\"meta\", attrs={\"name\":\"viewport\"})\n","    if vp and vp.get(\"content\"): s += 10\n","    return clamp(s)\n","\n","def score_seo(seo: Dict[str,Any], internal_links_est: int) -> int:\n","    s = 0\n","    if seo.get(\"has_title\"): s += 25\n","    if seo.get(\"title_len\",0) >= 10: s += 10\n","    if seo.get(\"has_desc\"): s += 20\n","    if seo.get(\"desc_len\",0) >= 40: s += 10\n","    if seo.get(\"has_h1\"): s += 15\n","    if seo.get(\"canonical\"): s += 10\n","    if seo.get(\"img_alt_ratio\",0) >= 0.6: s += 10\n","    if internal_links_est >= 5: s += 10\n","    return clamp(s)\n","\n","def score_ux_from_psi_or_fallback(psi: Dict[str,Any], ttfb: float) -> int:\n","    if psi.get(\"available\"):\n","        a = psi[\"scores\"].get(\"accessibility\", 0)\n","        p = psi[\"scores\"].get(\"performance\", 0)\n","        return clamp(0.55*a + 0.45*p)\n","    return clamp(50 + (score_from_ttfb(ttfb) - 50)*0.6)\n","\n","def score_trust(page_text: str, soup: BeautifulSoup) -> int:\n","    t = (page_text or \"\").lower()\n","    s = 40\n","    for kw in [\"testimonials\",\"case study\",\"reviews\",\"privacy\",\"terms\",\"clients\",\"contact\",\"about\"]:\n","        if kw in t:\n","            s += 6\n","    # contact signals\n","    if soup.find(string=re.compile(r\"@\")): s += 6\n","    if soup.find(string=re.compile(r\"\\+?\\d[\\d\\s\\-\\(\\)]{8,}\")): s += 6\n","    return clamp(s)\n","\n","def weighted_overall(categories: Dict[str,int]) -> int:\n","    w = {\n","        \"Performance\": 0.22,\n","        \"UX & CWV\": 0.20,\n","        \"SEO\": 0.18,\n","        \"Security\": 0.16,\n","        \"Best Practices\": 0.12,\n","        \"Content & Trust\": 0.12,\n","    }\n","    total = 0.0\n","    for k, weight in w.items():\n","        total += weight * float(categories.get(k, 0))\n","    return clamp(total)\n","\n","def build_metrics_by_category(metrics: Dict[str,Any], categories: Dict[str,int]) -> Dict[str,List[Dict[str,Any]]]:\n","    \"\"\"\n","    Returns:\n","      { \"Performance\":[{name,key,value,unit,status,desc,why,thresholds}], ... }\n","    Used by frontend modals & category drilldowns.\n","    \"\"\"\n","    hdrs = (metrics.get(\"headers\") or {})\n","    seo = (metrics.get(\"seo\") or {})\n","    psi = (metrics.get(\"pagespeed\") or {})\n","    links = (metrics.get(\"links\") or {})\n","\n","    def chip(score: int) -> str:\n","        if score >= 80: return \"GOOD\"\n","        if score >= 60: return \"OK\"\n","        return \"RISK\"\n","\n","    def status_for_value(key: str, value: Any) -> str:\n","        # Light heuristics\n","        if key == \"ttfb_seconds\":\n","            v = float(value or 9)\n","            if v <= 0.8: return \"GOOD\"\n","            if v <= 1.8: return \"OK\"\n","            return \"RISK\"\n","        if key in (\"psi_performance\",\"psi_accessibility\",\"psi_best_practices\",\"psi_seo\"):\n","            v = int(value or 0)\n","            if v >= 80: return \"GOOD\"\n","            if v >= 60: return \"OK\"\n","            return \"RISK\"\n","        if key in (\"https\",\"hsts\",\"csp\"):\n","            return \"GOOD\" if value else \"RISK\"\n","        return chip(70)\n","\n","    def thresholds_bar(key: str) -> Dict[str,Any]:\n","        if key == \"ttfb_seconds\":\n","            return {\"good\":\"≤0.8s\",\"ok\":\"0.8–1.8s\",\"risk\":\">1.8s\"}\n","        if key.startswith(\"psi_\"):\n","            return {\"good\":\"≥80\",\"ok\":\"60–79\",\"risk\":\"<60\"}\n","        if key in (\"https\",\"hsts\",\"csp\"):\n","            return {\"good\":\"Enabled\",\"ok\":\"—\",\"risk\":\"Missing\"}\n","        if key == \"meta_desc\":\n","            return {\"good\":\"Present\",\"ok\":\"Short\",\"risk\":\"Missing\"}\n","        return {\"good\":\"Good\",\"ok\":\"Okay\",\"risk\":\"Risk\"}\n","\n","    perf_items = []\n","    perf_items.append({\n","        \"key\":\"ttfb_seconds\",\"name\":\"TTFB\",\"value\": metrics.get(\"ttfb_seconds\"), \"unit\":\"s\",\n","        \"status\": status_for_value(\"ttfb_seconds\", metrics.get(\"ttfb_seconds\")),\n","        \"desc\":\"Time to first byte for the primary document.\",\n","        \"why\":\"Improves perceived speed and reduces bounce, especially on mobile.\",\n","        \"thresholds\": thresholds_bar(\"ttfb_seconds\")\n","    })\n","    if psi.get(\"available\"):\n","        sc = psi.get(\"scores\") or {}\n","        perf_items += [\n","            {\"key\":\"psi_performance\",\"name\":\"PSI Performance\",\"value\": sc.get(\"performance\",0),\"unit\":\"/100\",\n","             \"status\": status_for_value(\"psi_performance\", sc.get(\"performance\",0)),\n","             \"desc\":\"Lighthouse performance score from PageSpeed Insights.\",\n","             \"why\":\"Correlates with load experience and conversion rate.\",\n","             \"thresholds\": thresholds_bar(\"psi_performance\")},\n","        ]\n","    ux_items = []\n","    if psi.get(\"available\"):\n","        sc = psi.get(\"scores\") or {}\n","        ux_items += [\n","            {\"key\":\"psi_accessibility\",\"name\":\"Accessibility\",\"value\": sc.get(\"accessibility\",0),\"unit\":\"/100\",\n","             \"status\": status_for_value(\"psi_accessibility\", sc.get(\"accessibility\",0)),\n","             \"desc\":\"Accessibility score from PSI.\",\n","             \"why\":\"Improves usability and reduces friction across devices.\",\n","             \"thresholds\": thresholds_bar(\"psi_accessibility\")},\n","        ]\n","    else:\n","        ux_items.append({\n","            \"key\":\"fallback_ux\",\"name\":\"UX Proxy (Fallback)\",\"value\": categories.get(\"UX & CWV\",0),\"unit\":\"/100\",\n","            \"status\": chip(categories.get(\"UX & CWV\",0)),\n","            \"desc\":\"Fallback UX score derived from speed + page signals when PSI is unavailable.\",\n","            \"why\":\"Keeps audits usable when PSI is rate-limited.\",\n","            \"thresholds\": {\"good\":\"≥80\",\"ok\":\"60–79\",\"risk\":\"<60\"}\n","        })\n","\n","    seo_items = [\n","        {\"key\":\"title_len\",\"name\":\"Title length\",\"value\": seo.get(\"title_len\",0),\"unit\":\"chars\",\n","         \"status\": \"GOOD\" if seo.get(\"has_title\") else \"RISK\",\n","         \"desc\":\"Presence and length of the page title.\",\n","         \"why\":\"Title impacts rankings and click-through rate.\",\n","         \"thresholds\":{\"good\":\"10–60\",\"ok\":\"1–9\",\"risk\":\"Missing\"}},\n","        {\"key\":\"meta_desc\",\"name\":\"Meta description\",\"value\": \"Present\" if seo.get(\"has_desc\") else \"Missing\",\"unit\":\"\",\n","         \"status\": \"GOOD\" if seo.get(\"has_desc\") and seo.get(\"desc_len\",0) >= 40 else (\"OK\" if seo.get(\"has_desc\") else \"RISK\"),\n","         \"desc\":\"Meta description presence and quality.\",\n","         \"why\":\"Improves SERP CTR and keyword relevance.\",\n","         \"thresholds\": thresholds_bar(\"meta_desc\")},\n","        {\"key\":\"has_h1\",\"name\":\"H1\",\"value\": \"Present\" if seo.get(\"has_h1\") else \"Missing\",\"unit\":\"\",\n","         \"status\": \"GOOD\" if seo.get(\"has_h1\") else \"RISK\",\n","         \"desc\":\"Primary H1 heading presence.\",\n","         \"why\":\"Clarifies page topic for users and search engines.\",\n","         \"thresholds\":{\"good\":\"Present\",\"ok\":\"—\",\"risk\":\"Missing\"}},\n","        {\"key\":\"canonical\",\"name\":\"Canonical tag\",\"value\": \"Present\" if seo.get(\"canonical\") else \"Missing\",\"unit\":\"\",\n","         \"status\": \"GOOD\" if seo.get(\"canonical\") else \"OK\",\n","         \"desc\":\"Canonical link element presence.\",\n","         \"why\":\"Prevents duplicate content dilution.\",\n","         \"thresholds\":{\"good\":\"Present\",\"ok\":\"Optional\",\"risk\":\"Missing\"}},\n","        {\"key\":\"img_alt_ratio\",\"name\":\"Image alt coverage\",\"value\": round(float(seo.get(\"img_alt_ratio\",0))*100,1),\"unit\":\"%\",\n","         \"status\": \"GOOD\" if float(seo.get(\"img_alt_ratio\",0)) >= 0.6 else (\"OK\" if float(seo.get(\"img_alt_ratio\",0)) >= 0.3 else \"RISK\"),\n","         \"desc\":\"Percentage of images with alt attributes.\",\n","         \"why\":\"Supports accessibility and image search signals.\",\n","         \"thresholds\":{\"good\":\"≥60%\",\"ok\":\"30–59%\",\"risk\":\"<30%\"}},\n","        {\"key\":\"internal_links\",\"name\":\"Internal links (est.)\",\"value\": links.get(\"internal_est\",0),\"unit\":\"\",\n","         \"status\": \"GOOD\" if int(links.get(\"internal_est\",0)) >= 8 else (\"OK\" if int(links.get(\"internal_est\",0)) >= 3 else \"RISK\"),\n","         \"desc\":\"Estimated count of internal links on the page.\",\n","         \"why\":\"Helps crawlability and distributes authority.\",\n","         \"thresholds\":{\"good\":\"≥8\",\"ok\":\"3–7\",\"risk\":\"<3\"}},\n","    ]\n","\n","    sec_items = [\n","        {\"key\":\"https\",\"name\":\"HTTPS\",\"value\": bool(metrics.get(\"https\")), \"unit\":\"\",\n","         \"status\": status_for_value(\"https\", bool(metrics.get(\"https\"))),\n","         \"desc\":\"Whether the primary URL uses HTTPS.\",\n","         \"why\":\"Security and trust foundation; also a ranking factor.\",\n","         \"thresholds\": thresholds_bar(\"https\")},\n","        {\"key\":\"hsts\",\"name\":\"HSTS\",\"value\": bool(hdrs.get(\"strict-transport-security\")), \"unit\":\"\",\n","         \"status\": status_for_value(\"hsts\", bool(hdrs.get(\"strict-transport-security\"))),\n","         \"desc\":\"Strict-Transport-Security header presence.\",\n","         \"why\":\"Prevents protocol downgrade attacks.\",\n","         \"thresholds\": thresholds_bar(\"hsts\")},\n","        {\"key\":\"csp\",\"name\":\"Content Security Policy\",\"value\": bool(hdrs.get(\"content-security-policy\")), \"unit\":\"\",\n","         \"status\": status_for_value(\"csp\", bool(hdrs.get(\"content-security-policy\"))),\n","         \"desc\":\"CSP header presence.\",\n","         \"why\":\"Mitigates XSS and improves security posture.\",\n","         \"thresholds\": thresholds_bar(\"csp\")},\n","    ]\n","\n","    bp_items = []\n","    if psi.get(\"available\"):\n","        sc = psi.get(\"scores\") or {}\n","        bp_items.append({\n","            \"key\":\"psi_best_practices\",\"name\":\"Best Practices\",\"value\": sc.get(\"best_practices\",0),\"unit\":\"/100\",\n","            \"status\": status_for_value(\"psi_best_practices\", sc.get(\"best_practices\",0)),\n","            \"desc\":\"Lighthouse best practices score.\",\n","            \"why\":\"Captures modern web hygiene (security/UX/dev).\",\n","            \"thresholds\": thresholds_bar(\"psi_best_practices\")\n","        })\n","    bp_items += [\n","        {\"key\":\"x_frame_options\",\"name\":\"X-Frame-Options\",\"value\": \"Present\" if \"x-frame-options\" in hdrs else \"Missing\",\"unit\":\"\",\n","         \"status\": \"GOOD\" if \"x-frame-options\" in hdrs else \"OK\",\n","         \"desc\":\"Frame protection header presence.\",\n","         \"why\":\"Reduces clickjacking risk.\",\n","         \"thresholds\":{\"good\":\"Present\",\"ok\":\"Optional\",\"risk\":\"Missing\"}},\n","        {\"key\":\"referrer_policy\",\"name\":\"Referrer-Policy\",\"value\": \"Present\" if \"referrer-policy\" in hdrs else \"Missing\",\"unit\":\"\",\n","         \"status\": \"GOOD\" if \"referrer-policy\" in hdrs else \"OK\",\n","         \"desc\":\"Referrer privacy header presence.\",\n","         \"why\":\"Protects sensitive URL leakage.\",\n","         \"thresholds\":{\"good\":\"Present\",\"ok\":\"Optional\",\"risk\":\"Missing\"}},\n","    ]\n","\n","    trust_items = [\n","        {\"key\":\"external_links\",\"name\":\"External links (est.)\",\"value\": links.get(\"external_est\",0),\"unit\":\"\",\n","         \"status\": \"OK\" if int(links.get(\"external_est\",0)) <= 40 else \"RISK\",\n","         \"desc\":\"Estimated count of external links.\",\n","         \"why\":\"Too many external links can dilute focus and trust signals.\",\n","         \"thresholds\":{\"good\":\"≤20\",\"ok\":\"21–40\",\"risk\":\">40\"}},\n","    ]\n","\n","    return {\n","        \"Performance\": perf_items,\n","        \"UX & CWV\": ux_items,\n","        \"SEO\": seo_items,\n","        \"Security\": sec_items,\n","        \"Best Practices\": bp_items,\n","        \"Content & Trust\": trust_items,\n","    }\n","\n","def update_audit(audit_id: str, **fields):\n","    conn = db()\n","    cur = conn.cursor()\n","    row = cur.execute(\"SELECT * FROM audits WHERE id=?\", (audit_id,)).fetchone()\n","    if not row:\n","        conn.close()\n","        return\n","    # Build update\n","    cols = []\n","    vals = []\n","    for k,v in fields.items():\n","        if k == \"categories_json\" and isinstance(v, dict):\n","            cols.append(\"categories_json=?\"); vals.append(json.dumps(v))\n","        elif k == \"payload_json\" and isinstance(v, dict):\n","            cols.append(\"payload_json=?\"); vals.append(json.dumps(v))\n","        else:\n","            cols.append(f\"{k}=?\"); vals.append(v)\n","    cols.append(\"updated_at=?\"); vals.append(now_iso())\n","    vals.append(audit_id)\n","    q = \"UPDATE audits SET \" + \", \".join(cols) + \" WHERE id=?\"\n","    cur.execute(q, vals)\n","    conn.commit()\n","    conn.close()\n","\n","# ---------------- AI (safe fallback) ----------------\n","def ai_analyze(url: str, pages: List[Dict[str,Any]], metrics: Dict[str,Any], categories: Dict[str,int]) -> Dict[str,Any]:\n","    # No external model dependency; produce structured insights based on signals.\n","    seo = metrics.get(\"seo\") or {}\n","    hdrs = metrics.get(\"headers\") or {}\n","    ttfb = float(metrics.get(\"ttfb_seconds\") or 9)\n","    psi = metrics.get(\"pagespeed\") or {}\n","    pages_list = [p.get(\"url\",\"\") for p in (metrics.get(\"crawl\",{}).get(\"pages\") or [])][:6]\n","\n","    gaps = []\n","    fixes = []\n","    wins = []\n","    drivers = {}\n","\n","    if not metrics.get(\"https\"):\n","        gaps.append(\"Site is not consistently served over HTTPS.\")\n","        fixes.append(\"Force HTTPS site-wide and enable HSTS.\")\n","    if not hdrs.get(\"content-security-policy\"):\n","        gaps.append(\"Missing Content Security Policy (CSP).\")\n","        fixes.append(\"Add a baseline CSP to reduce XSS risk.\")\n","    if not seo.get(\"has_desc\"):\n","        gaps.append(\"Meta descriptions missing on primary page.\")\n","        fixes.append(\"Write unique meta descriptions for key pages (Home/About/Services).\")\n","    if not seo.get(\"has_h1\"):\n","        gaps.append(\"Primary H1 is missing or unclear.\")\n","        fixes.append(\"Add a single, descriptive H1 aligned to offer + audience.\")\n","    if ttfb > 1.8:\n","        gaps.append(\"Backend response is slow (high TTFB).\")\n","        fixes.append(\"Improve hosting, caching, and image optimization to reduce TTFB.\")\n","    if psi.get(\"error\") == \"rate_limited\":\n","        wins.append(\"PSI was rate-limited — rerun later for stronger Core Web Vitals validation.\")\n","\n","    # Quick wins based on categories\n","    if categories.get(\"SEO\",0) < 70:\n","        wins.append(\"Strengthen internal linking between Services → Case Studies → Contact.\")\n","        wins.append(\"Add structured FAQ blocks on services pages.\")\n","        drivers[\"SEO\"] = \"Meta + H1 + internal linking consistency\"\n","    if categories.get(\"Performance\",0) < 70:\n","        wins.append(\"Compress hero images (WebP/AVIF) and defer non-critical scripts.\")\n","        drivers[\"Performance\"] = \"TTFB + front-end weight\"\n","    if categories.get(\"Security\",0) < 80:\n","        wins.append(\"Add CSP + Permissions-Policy + Referrer-Policy headers.\")\n","        drivers[\"Security\"] = \"Security headers & HTTPS posture\"\n","\n","    business_overview = (\n","        f\"{url} appears to be positioned as a service-led brand. \"\n","        \"The audit focuses on speed, UX, SEO hygiene, security headers, and trust signals to improve conversion confidence.\"\n","    )\n","\n","    return {\n","        \"business_overview\": business_overview,\n","        \"brand_positioning\": \"Service-first positioning inferred from primary page signals. Clarify niche + outcomes in hero copy.\",\n","        \"target_audience\": \"Likely prospects searching for solutions; improve specificity via outcomes and proof blocks.\",\n","        \"key_offers\": [\"Brand strategy\", \"Website/UX improvements\", \"SEO + credibility improvements\"],\n","        \"trust_gaps\": gaps[:8],\n","        \"conversion_gaps\": [\"Improve page speed & clarity\", \"Add proof blocks (case studies, testimonials, logos)\"],\n","        \"priority_fixes\": fixes[:10] if fixes else [\"Improve metadata + internal links + security headers.\"],\n","        \"quick_wins_7_days\": wins[:10] if wins else [\"Polish metadata, tighten hero clarity, add proof and CTA alignment.\"],\n","        \"score_drivers\": drivers,\n","        \"confidence\": 72\n","    }\n","\n","# ---------------- FastAPI ----------------\n","app = FastAPI(title=APP_NAME)\n","\n","class LoginIn(BaseModel):\n","    org_slug: str\n","    email: str\n","    password: str\n","\n","class TokenOut(BaseModel):\n","    access_token: str\n","    refresh_token: str\n","\n","class RefreshIn(BaseModel):\n","    refresh_token: str\n","\n","class StartAuditIn(BaseModel):\n","    url: str\n","    strategy: Optional[str] = \"mobile\"\n","\n","@app.on_event(\"startup\")\n","def on_startup():\n","    ensure_schema()\n","    seed_demo()\n","\n","@app.get(\"/health\")\n","def health():\n","    return {\"ok\": True, \"app\": APP_NAME}\n","\n","@app.post(\"/auth/login\", response_model=TokenOut)\n","def auth_login(body: LoginIn):\n","    org_slug = (body.org_slug or \"\").strip().lower()\n","    email = (body.email or \"\").strip().lower()\n","    password = body.password or \"\"\n","\n","    if not org_slug or not email or not password:\n","        raise HTTPException(400, \"Missing login fields\")\n","\n","    conn = db()\n","    cur = conn.cursor()\n","    org = cur.execute(\"SELECT * FROM organizations WHERE slug=?\", (org_slug,)).fetchone()\n","    if not org:\n","        conn.close()\n","        raise HTTPException(401, \"Invalid org\")\n","\n","    user = cur.execute(\"SELECT * FROM users WHERE org_id=? AND email=?\", (org[\"id\"], email)).fetchone()\n","    if not user or not b64_check(password, user[\"password_hash\"]):\n","        conn.close()\n","        raise HTTPException(401, \"Invalid credentials\")\n","\n","    access = make_access_token(user[\"id\"], org[\"id\"], user[\"role\"])\n","    refresh = make_refresh_token()\n","    expires = (datetime.datetime.utcnow() + datetime.timedelta(days=REFRESH_TTL_DAYS)).isoformat()\n","\n","    cur.execute(\"INSERT INTO refresh_tokens(id,user_id,token,expires_at,created_at) VALUES (?,?,?,?,?)\",\n","                (str(uuid.uuid4()), user[\"id\"], refresh, expires, now_iso()))\n","    conn.commit()\n","    conn.close()\n","\n","    return {\"access_token\": access, \"refresh_token\": refresh}\n","\n","@app.post(\"/auth/refresh\", response_model=TokenOut)\n","def auth_refresh(body: RefreshIn):\n","    token = (body.refresh_token or \"\").strip()\n","    if not token:\n","        raise HTTPException(400, \"Missing refresh_token\")\n","    conn = db()\n","    cur = conn.cursor()\n","    row = cur.execute(\"SELECT * FROM refresh_tokens WHERE token=?\", (token,)).fetchone()\n","    if not row:\n","        conn.close()\n","        raise HTTPException(401, \"Invalid refresh token\")\n","\n","    # expiry\n","    try:\n","        exp = datetime.datetime.fromisoformat(row[\"expires_at\"])\n","        if exp < datetime.datetime.utcnow():\n","            cur.execute(\"DELETE FROM refresh_tokens WHERE token=?\", (token,))\n","            conn.commit()\n","            conn.close()\n","            raise HTTPException(401, \"Refresh token expired\")\n","    except:\n","        conn.close()\n","        raise HTTPException(401, \"Refresh token invalid\")\n","\n","    user = cur.execute(\"SELECT * FROM users WHERE id=?\", (row[\"user_id\"],)).fetchone()\n","    if not user:\n","        conn.close()\n","        raise HTTPException(401, \"Invalid session\")\n","\n","    org = cur.execute(\"SELECT * FROM organizations WHERE id=?\", (user[\"org_id\"],)).fetchone()\n","    if not org:\n","        conn.close()\n","        raise HTTPException(401, \"Invalid org\")\n","\n","    access = make_access_token(user[\"id\"], org[\"id\"], user[\"role\"])\n","    new_refresh = make_refresh_token()\n","    expires = (datetime.datetime.utcnow() + datetime.timedelta(days=REFRESH_TTL_DAYS)).isoformat()\n","\n","    # rotate refresh token\n","    cur.execute(\"DELETE FROM refresh_tokens WHERE token=?\", (token,))\n","    cur.execute(\"INSERT INTO refresh_tokens(id,user_id,token,expires_at,created_at) VALUES (?,?,?,?,?)\",\n","                (str(uuid.uuid4()), user[\"id\"], new_refresh, expires, now_iso()))\n","    conn.commit()\n","    conn.close()\n","\n","    return {\"access_token\": access, \"refresh_token\": new_refresh}\n","\n","@app.get(\"/me\")\n","def me(ctx: Ctx = Depends(get_ctx)):\n","    user, org = get_user_and_org(ctx)\n","    return {\"user\": {\"email\": user[\"email\"], \"role\": user[\"role\"]}, \"org\": {\"slug\": org[\"slug\"], \"name\": org[\"name\"]}}\n","\n","# -------- audit runner thread --------\n","def run_audit_thread(audit_id: str, url: str, strategy: str):\n","    url = normalize_url(url)\n","    try:\n","        update_audit(audit_id, status=\"RUNNING\", step=\"Fetch primary page\", progress=8)\n","\n","        ttfb, status, html, hdrs = fetch_ttfb_and_html(url)\n","        soup = BeautifulSoup(html or \"\", \"html.parser\")\n","        page_text = soup_text(soup)[:120000]\n","        internal, external, internal_urls = detect_links(soup, url)\n","\n","        update_audit(audit_id, step=\"Crawl key pages\", progress=20)\n","        extra = pick_extra_pages(url, soup)\n","        seeds = (extra + internal_urls)[:6]\n","\n","        pages = []\n","        if seeds:\n","            import asyncio\n","            try:\n","                pages = asyncio.run(fetch_pages_concurrent(seeds))\n","            except:\n","                pages = []\n","\n","        pages_all = [{\"url\": url, \"status\": status, \"title\": (soup.title.string.strip() if soup.title and soup.title.string else \"\"), \"text\": page_text[:20000]}] + pages\n","\n","        update_audit(audit_id, step=\"Run PageSpeed Insights\", progress=38)\n","        psi = pagespeed_run(url, strategy=strategy)\n","\n","        update_audit(audit_id, step=\"Compute metrics & scores\", progress=55)\n","        seo = seo_heuristics(soup)\n","\n","        metrics = {\n","            \"http_status\": status,\n","            \"ttfb_seconds\": round(ttfb, 3),\n","            \"https\": url.lower().startswith(\"https://\"),\n","            \"headers\": {k.lower(): v for k,v in hdrs.items()},\n","            \"seo\": seo,\n","            \"links\": {\"internal_est\": internal, \"external_est\": external},\n","            \"pagespeed\": psi,\n","            \"crawl\": {\"pages\": [{\"url\": p[\"url\"], \"status\": p[\"status\"], \"title\": p.get(\"title\",\"\")} for p in pages_all[:8]]},\n","        }\n","\n","        perf = psi[\"scores\"].get(\"performance\", 0) if psi.get(\"available\") else score_from_ttfb(ttfb)\n","        sec = score_https(url, metrics[\"headers\"])\n","        seo_score = score_seo(seo, internal)\n","        ux = score_ux_from_psi_or_fallback(psi, ttfb)\n","        bp = best_practices_score(metrics[\"headers\"], soup)\n","        trust = score_trust(page_text, soup)\n","\n","        categories = {\n","            \"Performance\": clamp(perf),\n","            \"UX & CWV\": clamp(ux),\n","            \"SEO\": clamp(seo_score),\n","            \"Security\": clamp(sec),\n","            \"Best Practices\": clamp(bp),\n","            \"Content & Trust\": clamp(trust)\n","        }\n","        overall = weighted_overall(categories)\n","\n","        update_audit(audit_id, step=\"Generate AI overview\", progress=78)\n","        ai = ai_analyze(url, pages_all, metrics, categories)\n","\n","        payload = {\n","            \"basic\": {\"url\": url, \"status\": status, \"ttfb\": ttfb},\n","            \"pagespeed\": psi,\n","            \"crawl\": {\"pages\": pages_all[:8]},\n","            \"metrics\": metrics,\n","            \"ai\": ai,\n","        }\n","\n","        update_audit(\n","            audit_id,\n","            status=\"COMPLETE\",\n","            step=\"Done\",\n","            progress=100,\n","            overall=int(overall),\n","            categories_json=categories,\n","            payload_json=payload,\n","            error=None\n","        )\n","\n","    except Exception as e:\n","        update_audit(audit_id, status=\"FAILED\", step=\"Failed\", progress=100, error=str(e)[:500])\n","\n","@app.post(\"/audits/start\")\n","def audits_start(body: StartAuditIn, ctx: Ctx = Depends(get_ctx)):\n","    user, org = get_user_and_org(ctx)\n","    url = normalize_url(body.url)\n","    if not url:\n","        raise HTTPException(400, \"Missing url\")\n","    strategy = (body.strategy or \"mobile\").lower()\n","    if strategy not in (\"mobile\",\"desktop\"):\n","        strategy = \"mobile\"\n","\n","    audit_id = str(uuid.uuid4())\n","    try:\n","        conn = db()\n","        cur = conn.cursor()\n","        cur.execute(\"\"\"\n","          INSERT INTO audits(\n","            id,org_id,user_id,url,strategy,status,step,progress,error,\n","            overall,categories_json,payload_json,created_at,updated_at\n","          ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)\n","        \"\"\", (\n","            audit_id, org[\"id\"], user[\"id\"], url, strategy,\n","            \"QUEUED\", \"Queued\", 0, None,\n","            0, json.dumps({}), json.dumps({}), now_iso(), now_iso()\n","        ))\n","        conn.commit()\n","        conn.close()\n","    except Exception as e:\n","        # Most common: stale schema/db locked\n","        raise HTTPException(500, f\"Failed to create audit: {str(e)[:200]}\")\n","\n","    th = threading.Thread(target=run_audit_thread, args=(audit_id, url, strategy), daemon=True)\n","    th.start()\n","    return {\"audit_id\": audit_id}\n","\n","@app.get(\"/audits/{audit_id}\")\n","def audits_get(audit_id: str, ctx: Ctx = Depends(get_ctx)):\n","    user, org = get_user_and_org(ctx)\n","    conn = db()\n","    cur = conn.cursor()\n","    row = cur.execute(\"SELECT * FROM audits WHERE id=? AND org_id=?\", (audit_id, org[\"id\"])).fetchone()\n","    conn.close()\n","    if not row:\n","        raise HTTPException(404, \"Audit not found\")\n","\n","    categories = json.loads(row[\"categories_json\"] or \"{}\")\n","    payload = json.loads(row[\"payload_json\"] or \"{}\")\n","    metrics = (payload.get(\"metrics\") or {})\n","\n","    metrics_by_category = build_metrics_by_category(metrics, categories)\n","\n","    return {\n","        \"id\": row[\"id\"],\n","        \"url\": row[\"url\"],\n","        \"strategy\": row[\"strategy\"],\n","        \"status\": row[\"status\"],\n","        \"step\": row[\"step\"],\n","        \"progress\": row[\"progress\"],\n","        \"error\": row[\"error\"],\n","        \"overall\": row[\"overall\"],\n","        \"categories\": categories,\n","        \"payload\": payload,\n","        \"metrics_by_category\": metrics_by_category,\n","        \"created_at\": row[\"created_at\"],\n","        \"updated_at\": row[\"updated_at\"],\n","    }\n","\n","@app.get(\"/audits\")\n","def audits_list(limit: int = 50, ctx: Ctx = Depends(get_ctx)):\n","    user, org = get_user_and_org(ctx)\n","    limit = max(1, min(int(limit or 50), 200))\n","    conn = db()\n","    cur = conn.cursor()\n","    rows = cur.execute(\"\"\"\n","        SELECT id,url,strategy,status,overall,created_at\n","        FROM audits\n","        WHERE org_id=?\n","        ORDER BY created_at DESC\n","        LIMIT ?\n","    \"\"\", (org[\"id\"], limit)).fetchall()\n","    conn.close()\n","    return [dict(r) for r in rows]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ShLMpiJ7zW7f","executionInfo":{"status":"ok","timestamp":1772350748475,"user_tz":-330,"elapsed":710,"user":{"displayName":"Paul","userId":"12964447588728138498"}},"outputId":"235d5718-f260-4518-f52c-dae4bb1f8371"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing backend.py\n"]}]},{"cell_type":"code","source":["%%writefile app.py\n","import os, time, math\n","import requests\n","import streamlit as st\n","import pandas as pd\n","import plotly.graph_objects as go\n","\n","API_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8000\").strip()\n","\n","THEME = dict(\n","    bg=\"#F6F7FB\", panel=\"#FFFFFF\",\n","    text=\"#0B0E14\", muted=\"rgba(11,14,20,0.62)\",\n","    border=\"rgba(0,0,0,0.10)\", border2=\"rgba(0,0,0,0.18)\",\n","    accent=\"#0A84FF\", good=\"#34C759\", warn=\"#FF9F0A\", risk=\"#FF3B30\",\n","    glow=\"rgba(10,132,255,0.11)\"\n",")\n","\n","def inject_css():\n","    t = THEME\n","\n","    # IMPORTANT: this is NOT an f-string (avoids { } CSS brace bugs)\n","    css = \"\"\"\n","    <style>\n","      html, body, [class*=\"css\"] {\n","        background:\n","          radial-gradient(1200px 650px at 14% 0%, __GLOW__, transparent 58%),\n","          radial-gradient(900px 550px at 86% 5%, rgba(52,199,89,0.07), transparent 60%),\n","          __BG__ !important;\n","        color: __TEXT__ !important;\n","        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"SF Pro Display\",\n","                     \"SF Pro Text\", Inter, Segoe UI, Helvetica, Arial !important;\n","      }\n","      .block-container { padding-top: 0.8rem; max-width: 1320px; }\n","      #MainMenu {visibility:hidden;} footer {visibility:hidden;} header {visibility:hidden;}\n","\n","      .topbar {\n","        position: sticky; top: 0; z-index: 999;\n","        background: color-mix(in srgb, __BG__ 86%, transparent);\n","        backdrop-filter: blur(16px);\n","        border-bottom: 1px solid __BORDER__;\n","        padding: 10px 0 12px 0;\n","        margin-bottom: 14px;\n","      }\n","      .brand {\n","        font-weight: 950;\n","        letter-spacing: -0.05em;\n","        font-size: 18px;\n","        color: __TEXT__;\n","      }\n","      .panel {\n","        background: color-mix(in srgb, __PANEL__ 92%, transparent);\n","        border: 1px solid __BORDER__;\n","        border-radius: 18px;\n","        padding: 14px 14px;\n","      }\n","      .muted { color: __MUTED__; }\n","      .chip {\n","        display:inline-flex; align-items:center; gap:6px;\n","        padding: 4px 10px; border-radius: 999px;\n","        border: 1px solid __BORDER__; background: rgba(255,255,255,0.75);\n","        font-size: 12px;\n","      }\n","      .hr { height:1px; background:__BORDER__; margin: 10px 0; }\n","\n","      .stButton button {\n","        border-radius: 14px !important;\n","        border: 1px solid __BORDER__ !important;\n","        background: color-mix(in srgb, __PANEL__ 92%, transparent) !important;\n","      }\n","      .stTextInput input, .stSelectbox div[data-baseweb=\"select\"] > div {\n","        border-radius: 14px !important;\n","        border: 1px solid __BORDER__ !important;\n","        background: color-mix(in srgb, __PANEL__ 92%, transparent) !important;\n","      }\n","\n","      /* ---------- Streamlit-version-safe custom modal ---------- */\n","      .modal-backdrop{\n","        position:fixed; inset:0;\n","        background:rgba(0,0,0,0.65);\n","        backdrop-filter: blur(6px);\n","        display:flex; align-items:center; justify-content:center;\n","        z-index:9999;\n","      }\n","      .modal-card{\n","        width: 760px; max-width: 92vw;\n","        background: __PANEL__;\n","        border-radius: 22px;\n","        padding: 26px;\n","        border: 2px solid __BORDER2__;\n","        box-shadow: 0 40px 130px rgba(0,0,0,0.55);\n","        opacity: 1;\n","      }\n","      .modal-head{display:flex; justify-content:space-between; gap:14px; align-items:flex-start;}\n","      .modal-title{font-size:20px; font-weight:950; letter-spacing:-0.02em;}\n","      .modal-value{margin-top:8px; font-size:38px; font-weight:950; letter-spacing:-0.03em; line-height:1.05;}\n","      .modal-unit{font-size:14px; font-weight:800; opacity:.7;}\n","      .modal-chip{\n","        display:inline-flex; margin-top:10px;\n","        padding:6px 12px; border-radius:999px;\n","        border:2px solid; font-weight:950; font-size:12px;\n","        background: rgba(255,255,255,0.72);\n","      }\n","      .modal-grid{display:grid; grid-template-columns: 1.1fr 0.9fr; gap:18px;}\n","      .modal-h{font-weight:950; font-size:13px;}\n","      .modal-p{color:__MUTED__; margin-top:6px; line-height:1.5;}\n","      .thr-row{display:flex; gap:10px; margin-top:10px;}\n","      .thr{flex:1; padding:12px; border-radius:14px; border:1px solid __BORDER__;}\n","      .thr-k{font-weight:950; font-size:12px;}\n","      .thr-v{margin-top:4px; font-size:12px; color:__MUTED__;}\n","      .thr-good{background: __GOOD__22;}\n","      .thr-good .thr-k{color: __GOOD__;}\n","      .thr-ok{background: __WARN__22;}\n","      .thr-ok .thr-k{color: __WARN__;}\n","      .thr-risk{background: __RISK__22;}\n","      .thr-risk .thr-k{color: __RISK__;}\n","    </style>\n","    \"\"\"\n","\n","    css = (css\n","           .replace(\"__BG__\", t[\"bg\"])\n","           .replace(\"__PANEL__\", t[\"panel\"])\n","           .replace(\"__TEXT__\", t[\"text\"])\n","           .replace(\"__MUTED__\", t[\"muted\"])\n","           .replace(\"__BORDER__\", t[\"border\"])\n","           .replace(\"__BORDER2__\", t[\"border2\"])\n","           .replace(\"__GLOW__\", t[\"glow\"])\n","           .replace(\"__GOOD__\", t[\"good\"])\n","           .replace(\"__WARN__\", t[\"warn\"])\n","           .replace(\"__RISK__\", t[\"risk\"])\n","          )\n","\n","    st.markdown(css, unsafe_allow_html=True)\n","\n","# ---------- API helpers ----------\n","def access_token():\n","    tok = st.session_state.get(\"access_token\")\n","    if not tok or not isinstance(tok, str) or tok.strip().lower() in (\"none\",\"null\",\"\"):\n","        return None\n","    return tok.strip()\n","\n","def headers():\n","    tok = access_token()\n","    return {\"Authorization\": f\"Bearer {tok}\"} if tok else {}\n","\n","def refresh_tokens():\n","    rt = st.session_state.get(\"refresh_token\")\n","    if not rt or \".\" not in rt:\n","        return False\n","    try:\n","        r = requests.post(API_BASE+\"/auth/refresh\", json={\"refresh_token\": rt}, timeout=30)\n","        if r.status_code != 200:\n","            return False\n","        data = r.json()\n","        st.session_state.access_token = data.get(\"access_token\")\n","        st.session_state.refresh_token = data.get(\"refresh_token\")\n","        return bool(access_token())\n","    except:\n","        return False\n","\n","def api_get(path, timeout=60):\n","    r = requests.get(API_BASE+path, headers=headers(), timeout=timeout)\n","    if r.status_code == 401 and refresh_tokens():\n","        r = requests.get(API_BASE+path, headers=headers(), timeout=timeout)\n","    if r.status_code >= 400:\n","        st.error(f\"API error {r.status_code} on {path}\")\n","        st.code(r.text[:2500])\n","        r.raise_for_status()\n","    return r.json()\n","\n","def api_post(path, payload, timeout=120):\n","    r = requests.post(API_BASE+path, json=payload, headers=headers(), timeout=timeout)\n","    if r.status_code == 401 and refresh_tokens():\n","        r = requests.post(API_BASE+path, json=payload, headers=headers(), timeout=timeout)\n","    if r.status_code >= 400:\n","        st.error(f\"API error {r.status_code} on {path}\")\n","        st.code(r.text[:2500])\n","        r.raise_for_status()\n","    return r.json()\n","\n","# ---------- visuals ----------\n","def col_for(s:int):\n","    t = THEME\n","    if s >= 80: return t[\"good\"]\n","    if s >= 60: return t[\"warn\"]\n","    return t[\"risk\"]\n","\n","def orbit_hud(categories: dict, overall: int):\n","    labels = sorted(list(categories.keys()), key=lambda x: x.lower())\n","    scores = [int(categories[k]) for k in labels]\n","    n = max(1, len(labels))\n","\n","    radii = [1.15 - (s/100)*0.60 for s in scores]\n","    angles = [2*math.pi*(i/n) for i in range(n)]\n","    xs = [r*math.cos(a) for r,a in zip(radii, angles)]\n","    ys = [r*math.sin(a) for r,a in zip(radii, angles)]\n","    xl = [1.35*math.cos(a) for a in angles]\n","    yl = [1.35*math.sin(a) for a in angles]\n","\n","    fig = go.Figure()\n","    for rr, w, op in [(0.55,2,0.20),(0.75,1,0.16),(0.95,1,0.14),(1.15,1,0.12)]:\n","        fig.add_shape(type=\"circle\", xref=\"x\", yref=\"y\",\n","                      x0=-rr, y0=-rr, x1=rr, y1=rr,\n","                      line=dict(color=\"rgba(10,132,255,0.28)\", width=w),\n","                      opacity=op)\n","\n","    for i in range(n):\n","        fig.add_trace(go.Scatter(\n","            x=[xs[i], xl[i]], y=[ys[i], yl[i]],\n","            mode=\"lines\",\n","            line=dict(color=\"rgba(0,0,0,0.12)\", width=2),\n","            hoverinfo=\"skip\", showlegend=False\n","        ))\n","\n","    fig.add_trace(go.Scatter(\n","        x=xs, y=ys, mode=\"markers\",\n","        marker=dict(size=[26+(s/8) for s in scores], color=[col_for(s) for s in scores], opacity=0.18),\n","        hoverinfo=\"skip\", showlegend=False\n","    ))\n","\n","    fig.add_trace(go.Scatter(\n","        x=xs, y=ys, mode=\"markers\",\n","        marker=dict(size=[12+(s/10) for s in scores],\n","                    color=[col_for(s) for s in scores],\n","                    line=dict(color=\"rgba(255,255,255,0.30)\", width=1)),\n","        text=labels, customdata=scores,\n","        hovertemplate=\"<b>%{text}</b><br>Score: %{customdata}<extra></extra>\",\n","        showlegend=False\n","    ))\n","\n","    fig.add_trace(go.Scatter(\n","        x=xl, y=yl, mode=\"text\",\n","        text=[f\"{k}  •  {s}\" for k,s in zip(labels, scores)],\n","        textfont=dict(color=THEME[\"muted\"], size=12),\n","        hoverinfo=\"skip\", showlegend=False\n","    ))\n","\n","    fig.add_trace(go.Scatter(\n","        x=[0], y=[0], mode=\"markers+text\",\n","        marker=dict(size=52, color=col_for(overall), line=dict(color=\"rgba(255,255,255,0.24)\", width=2)),\n","        text=[f\"{overall}\"],\n","        textposition=\"middle center\",\n","        textfont=dict(color=THEME[\"text\"], size=18),\n","        hoverinfo=\"skip\", showlegend=False\n","    ))\n","\n","    fig.update_layout(\n","        height=440, margin=dict(l=8,r=8,t=8,b=8),\n","        paper_bgcolor=\"rgba(0,0,0,0)\", plot_bgcolor=\"rgba(0,0,0,0)\",\n","        xaxis=dict(visible=False), yaxis=dict(visible=False),\n","    )\n","    fig.update_yaxes(scaleanchor=\"x\", scaleratio=1)\n","    return fig\n","\n","# ---------- modal ----------\n","def metric_dialog(metric: dict):\n","    if not st.session_state.get(\"show_modal\"):\n","        return\n","\n","    name = metric.get(\"name\",\"Metric\")\n","    value = metric.get(\"value\",\"—\")\n","    unit  = metric.get(\"unit\",\"\")\n","    status = metric.get(\"status\",\"OK\")\n","    desc = metric.get(\"desc\",\"\")\n","    why  = metric.get(\"why\",\"\")\n","    thr  = metric.get(\"thresholds\") or {}\n","\n","    color = THEME[\"warn\"]\n","    if status == \"GOOD\": color = THEME[\"good\"]\n","    if status == \"RISK\": color = THEME[\"risk\"]\n","\n","    st.markdown(f\"\"\"\n","    <div class=\"modal-backdrop\">\n","      <div class=\"modal-card\">\n","        <div class=\"modal-head\">\n","          <div>\n","            <div class=\"modal-title\">{name}</div>\n","            <div class=\"modal-value\">{value} <span class=\"modal-unit\">{unit}</span></div>\n","            <div class=\"modal-chip\" style=\"border-color:{color}; color:{color};\">{status}</div>\n","          </div>\n","          <div style=\"text-align:right;\">\n","            <div class=\"muted\" style=\"font-size:12px;\">Metric details</div>\n","          </div>\n","        </div>\n","        <div class=\"hr\"></div>\n","        <div class=\"modal-grid\">\n","          <div>\n","            <div class=\"modal-h\">What it is</div>\n","            <div class=\"modal-p\">{desc or \"—\"}</div>\n","            <div style=\"height:12px;\"></div>\n","            <div class=\"modal-h\">Why it matters</div>\n","            <div class=\"modal-p\">{why or \"—\"}</div>\n","          </div>\n","          <div>\n","            <div class=\"modal-h\">Thresholds</div>\n","            <div class=\"thr-row\">\n","              <div class=\"thr thr-good\"><div class=\"thr-k\">Good</div><div class=\"thr-v\">{thr.get(\"good\",\"—\")}</div></div>\n","              <div class=\"thr thr-ok\"><div class=\"thr-k\">OK</div><div class=\"thr-v\">{thr.get(\"ok\",\"—\")}</div></div>\n","              <div class=\"thr thr-risk\"><div class=\"thr-k\">Risk</div><div class=\"thr-v\">{thr.get(\"risk\",\"—\")}</div></div>\n","            </div>\n","            <div style=\"height:14px;\"></div>\n"