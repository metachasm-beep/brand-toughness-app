generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  tier          String    @default("FREE") // FREE, PRO, BUSINESS
  audits        Audit[]
  brandVaults   BrandVault[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Audit {
  id            String         @id @default(cuid())
  url           String
  uid           String         @unique
  status        String         @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  overallScore  Int?
  categories    Json?          // Stores scores per category: { "SEO": 85, "Performance": 92, ... }
  findings      AuditFinding[]
  user          User?          @relation(fields: [userEmail], references: [email])
  userEmail     String?
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?
  meta          Json?          // Stores extra meta like PageSpeed data, headers, etc.
  
  // BrandOS specific fields
  brandIdentity BrandIdentity?
  clarityScore       Int?
  consistencyScore   Int?
  differentiationScore Int?
  emotionalImpactScore Int?
}

model BrandVault {
  id               String          @id @default(cuid())
  domain           String
  userEmail        String
  user             User?           @relation(fields: [userEmail], references: [email])
  totalAudits      Int             @default(0)
  evolvingContext  Json?           // Current best understanding of identity
  knowledgeItems   KnowledgeItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([domain, userEmail])
}

model KnowledgeItem {
  id           String     @id @default(cuid())
  vaultId      String
  vault        BrandVault @relation(fields: [vaultId], references: [id])
  type         String     // STRATEGIC, VISUAL, MESSAGING, UX
  content      String
  meta         Json?      // Scores or technical findings
  createdAt    DateTime   @default(now())
}

model BrandIdentity {
  id               String   @id @default(cuid())
  auditId          String   @unique
  audit            Audit    @relation(fields: [auditId], references: [id])
  businessDesc     String?
  vision           String?
  mission          String?
  targetAudience   String?
  positioning      String?
  toneOfVoice      String?
  messagingPillars Json?    // Array of key messaging points
  taglineDirects   Json?
  playbook         Json?    // Stores the Communication Playbook data
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditFinding {
  id             String   @id @default(cuid())
  auditId        String
  audit          Audit    @relation(fields: [auditId], references: [id])
  code           String   // e.g., "SEO_MISSING_TITLE"
  title          String
  category       String   // SEO, Performance, etc.
  severity       String   // CRITICAL, HIGH, MEDIUM, LOW
  confidence     Float    @default(1.0)
  recommendation String
  effort         String   // EASY, MEDIUM, HARD
  impact         String
  evidence       Json?    // Snippet or data found
}
